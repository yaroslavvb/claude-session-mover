    pf.add_argument("--json", action="store_true", dest="as_json",
                    help="the whole candidate rows as JSON, for a script")

    ps = sub.add_parser("stop", help="end a session csm moved, and free its window",
                        description="End a session THIS TOOL moved and remove the tmux "
                                    "window it opened — the cleanup, and the unblocker for "
                                    "moving the same session to the same account again. It "
                                    "stops nothing else: the authorisation is csm's own "
                                    "window (`moved-<id8>` in `csm-<account>`) plus, for a "
                                    "running session, a registry row naming that window. "
                                    "The transcript is never deleted.")
    ps.add_argument("session", help="row number from `csm list`, session id or prefix, "
