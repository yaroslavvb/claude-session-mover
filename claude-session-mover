                         f"{DEFAULT_LIMIT}, which never cuts a live session). It wins over "
                         f"--all, and the table says how many rows it left out")

    pm = sub.add_parser("move", help="move one session to another account",
                        description="Copy a session into another account's config home "
                                    "and resume it there, on that account's quota. Both "
                                    "homes are on THIS machine, unless --from-machine "
