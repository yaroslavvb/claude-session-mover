__version__ = "0.5.0"
PROG = "claude-session-mover"

HOME = Path(os.path.expanduser("~"))


def _env_path(var: str, default: Path) -> Path:
    v = os.environ.get(var)
    return Path(os.path.expanduser(v)) if v else default


#: Knobs that would not parse as a number, remembered here because `log` does not exist yet
#: at import time. `main` writes them to the log, never to a stream.
BAD_ENV: list = []


def _env_num(var: str, default, cast=int):
    """A numeric knob, falling back to its default rather than raising.

    🛑 AN UNPARSEABLE KNOB MAY NOT TAKE THE TOOL DOWN. These are read at import time, so a
    `ValueError` here is a traceback before `main` has run — on every subcommand, including
    `modes --check`, whose whole promise is one line on stdout and nothing on stderr. A
    scheduled caller reads that traceback as a fault in the machine's permission modes,
    which is the opposite of what happened: somebody typed `CSM_LIMIT=lots` in a shell
    profile. The same rule the rest of the file follows for a value it cannot use — a
    malformed memory store, a `CSM_TMUX_SESSION` naming a field that does not exist — is
    "ignore it and say so in the log", and the log is where this goes, because the one
    stream a caller parses may not carry it.
    """
    v = (os.environ.get(var) or "").strip()
    if not v:
        return default
    try:
        return cast(v)
    except ValueError:
        BAD_ENV.append("%s=%r is not a number: using %s" % (var, v, default))
        return default


_XDG_STATE = Path(os.environ.get("XDG_STATE_HOME") or HOME / ".local" / "state")
_XDG_CONFIG = Path(os.environ.get("XDG_CONFIG_HOME") or HOME / ".config")
STATE_DIR = _env_path("CSM_STATE_DIR", _XDG_STATE / PROG)
LOG = _env_path("CSM_LOG", STATE_DIR / "log")
#: Where `list` leaves its numbering, so `move 3` means the row you just read. Per machine.
PICKS = _env_path("CSM_PICKS", STATE_DIR / "picks.json")
#: Where a pane's scrollback is parked before anything is signalled. A pane holds the one
#: thing no file does: what the agent had typed and not yet sent. Measured: killing a tmux
#: session to clear the way for a move ended six sessions at once, and the two unsent drafts
#: in them survived only because somebody had captured the panes by hand first.
#: 🛑 These files hold conversation text. They are written 0600 in a 0700 dated directory
#: under the state dir, and they belong on the machine that wrote them — never in a synced
#: folder and never anywhere a web server serves.
CAPTURES = _env_path("CSM_CAPTURES", STATE_DIR / "captures")
ACCOUNTS_FILE = _env_path("CSM_ACCOUNTS", _XDG_CONFIG / PROG / "accounts")
#: What this machine is called in the accounts file's `machines` column, and as the name a
#: `--machine` target is compared against. The short hostname by default; set it when the
#: name the accounts file uses is not the hostname (machines get renamed, and a hostname
#: can carry a collision suffix). An unrecognised value is survivable on purpose — see
#: `accounts_here`.
MACHINE = os.environ.get("CSM_MACHINE") or ""
#: Per-machine path roots, as JSON: `{"<machine>": {"home": "<path>", "<label>": "<path>"}}`.
#: Only the top-level KEYS are read here — the set of machines this tool knows, for the
#: `--machine` check. Translating a folder from one machine's spelling to another's reads
#: the values.
MACHINES_FILE = _env_path("CSM_MACHINES", _XDG_CONFIG / PROG / "machines.json")
#: Home-relative directory names that are THE SAME SYNCED FOLDER on every machine, as a
#: comma list (`git-shared,work`). Such a directory is usually a symlink into a sync
#: client's own tree, and a transcript records the symlink spelling, which no named root in
#: `CSM_MACHINES` ever matches — so this is the rule that translates it. Empty by default,
#: and then a folder is only ever translated home-to-home. See `translate_cwd`.
SYNC_DIRS = tuple(x for x in (y.strip().strip("/") for y in
                              (os.environ.get("CSM_SYNC_DIRS") or "").split(",")) if x)
#: `CSM_DESKTOP_INDEX` — the desktop app's own session index, where a session it opened
#: keeps its TITLE, which is nowhere in the transcript. It is NOT read here: the only code
#: that reads it is `REMOTE_HELPER`, from the environment of whichever machine the session
#: is on, because an override set here would be this machine's spelling and wrong there. Its
#: default and its shape are documented above that string.

#: Where a copy from another machine is staged before it is filed into the target home.
#: 🛑 Never anybody's `projects/`: a staged file is kept as the record of what crossed, and
#: a stray `<id>.jsonl` in a `projects/` folder is exactly what makes `--resume <id>`
#: ambiguous (see `preflight`).
IMPORTS = _env_path("CSM_IMPORTS", STATE_DIR / "imports")
#: `--mirror-cwd` copies no file bigger than this, except under `.git/`: code crosses, data
#: does not. A recording, a model or a database belongs where it was made.
MIRROR_FILE_MAX = _env_num("CSM_MIRROR_FILE_MAX", 25 * 1024 * 1024)
#: And a mirror bigger than this in all is refused rather than copied.
MIRROR_TOTAL_MAX = _env_num("CSM_MIRROR_TOTAL_MAX", 2 * 1024 ** 3)
#: The machine's SHARED settings home: the one `settings.json` several account homes may
#: symlink to, and therefore the one file that can carry an auto-memory store key for all
#: of them at once. `machine_default_mode` reads it FIRST, before any account home, so one
#: shared `settings.json` answers for every account at once and a home whose symlink has
#: been replaced still reports its own drift honestly.
#: 🛑 `memory_store` deliberately does NOT read it. "What does this MACHINE ask for" is a
#: question about the machine, and the shared file is the right place to ask it; "where
#: does THIS HOME read memory from" is a question about one home, and the CLI answers it
#: from that home's own settings alone. See `memory_store`.
SHARED_HOME = _env_path("CSM_SHARED_HOME", HOME / ".claude")
#: A quota meter, as JSON: `{"<account name or handle>": {"five_hour": <percent used>,
#: "seven_day": <percent used>, "at": <epoch>, "resets_at": "", "error": ""}}`. Unset, or
#: unreadable, means the meter is UNREAD — never "free": see `meters`.
METERS_FILE = _env_path("CSM_METERS", _XDG_CONFIG / PROG / "meters.json")
#: How old a meter reading may be and still be a reading.
METER_MAX_AGE_S = _env_num("CSM_METER_MAX_AGE", 3.0 * 3600, float)
#: 🛑 `--to auto` SKIPS an account at or over either of these percentages, and the same two
#: numbers are what makes a NAMED target "near its limit" in the plan. Percent USED, so a
#: higher number is a riskier move; the weekly one is the looser of the two because a
#: weekly window refills slowly and a 5-hour one refills by itself.
AUTO_FIVE_HOUR_MAX = _env_num("CSM_AUTO_MAX_5H", 90.0, float)
AUTO_SEVEN_DAY_MAX = _env_num("CSM_AUTO_MAX_7D", 95.0, float)

#: An optional probe for whether the TARGET account can already be reached in this folder
#: by whatever runs sessions here for it (a per-account server, a room, a worker pool): a
#: command template carrying `{handle}`, whose stdout is a table whose fourth
#: whitespace-separated field is a folder. Unset means no such note is made at all.
#: 🛑 A probe that exits non-zero says NOTHING. The same doctrine as the credential check:
#: "could not look" is never a verdict, and a failed probe that was read as an answer would
#: state positively that the account has no way in here.
ROOM_CMD = os.environ.get("CSM_ROOM_CMD") or ""
#: The cure appended to that note, as a template carrying `{handle}`, `{name}` and `{cwd}`.
#: Unset, only the fact is printed: the fix is whatever your own tooling is, and inventing
#: a command is worse than naming none.
ROOM_FIX = os.environ.get("CSM_ROOM_FIX") or ""

#: Where a supervisor that owns a session keeps its state: one `<name>.json` per owner,
#: each with a `session_id`. A plain `move` of a session named there is REFUSED, because
#: the supervisor is the thing that has to be told — see `owner_of`. Unreadable, or absent,
#: means no session is owned, so an installation with no such supervisor sees nothing.
BOTS_DIR = _env_path("CSM_BOTS_DIR", STATE_DIR / "owners")
#: The cure in that refusal, as a template carrying `{owner}`, `{to}` and `{id}`. Unset,
#: the refusal names `--copy-only` and leaves the gesture to the reader.
BOT_FIX = os.environ.get("CSM_BOT_FIX") or ""
#: Where a SCHEDULED-PASS supervisor records the session each of its passes runs as: one
#: `<job>.session` file per job, of `key=value` lines, whose `uuid=` is the LOCAL session
#: id (the last `uuid=` line wins — the file is appended to, not rewritten). The fleet this
#: was written against keeps them in `~/drive.unsynced/rc-jobs` and has a `--revive` of its
#: own that puts the pass back on the SAME claude.ai link, so a session named here is
#: revived by its owner and not by this tool: `revive` refuses it and says whose command it
#: is. Same two readings as `CSM_BOTS_DIR` — absent means no such supervisor, unreadable is
#: a refusal — and UNSET means nothing is owned this way at all, because the default
#: installation has no such program.
RC_JOBS_DIR = _env_path("CSM_RC_JOBS_DIR", Path("")) if os.environ.get(
    "CSM_RC_JOBS_DIR") else None

#: How long a config home keeps a transcript the CLI has not touched. Absent from the
#: settings means the CLI's own default; `0` switches the sweep off. Read only to WARN, in
#: `target_notes`: nothing here ever deletes a transcript.
RETENTION_DEFAULT_DAYS = 30

#: How much of a transcript is read: a head and a tail, never a full parse. A multi-MB
#: transcript is normal and a home holds hundreds, so a listing row costs two seeks.
HEAD_BYTES = _env_num("CSM_HEAD_BYTES", 96 * 1024)
TAIL_BYTES = _env_num("CSM_TAIL_BYTES", 384 * 1024)
#: 🛑 HOW MUCH `revive` READS TO SAY WHY A SESSION STOPPED — and it is NOT `TAIL_BYTES`.
#: A listing row wants a cheap verdict; a revive is about to act on that verdict, so it
#: reads further back. Measured on the incident this was written for (CLI 2.1.312, Wed 28
#: Oct 2026): `usage_limit_reached` and `quotaLimits` appear in the last 512 KiB of that
#: 2.6 MB transcript and NOT in the last 384 KiB, so the listing window misses the stop by
#: ~120 KiB and reads the file as a clean finish. One agentic turn writes megabytes of tool
#: results after its own prompt, which is why the window is this wide for a file of any
#: size.
REVIVE_TAIL_BYTES = _env_num("CSM_REVIVE_TAIL", 1024 * 1024)
#: How many sessions `list` shows when nothing was asked for, and the ceiling `--all` has.
#: An EXPLICIT `--limit N` is a hard cap instead, and obeys neither (see `all_sessions`).
DEFAULT_LIMIT = _env_num("CSM_LIMIT", 20)
ALL_LIMIT = _env_num("CSM_ALL_LIMIT", 300)
#: How far back `find` and `--from-machine` look on a machine, in days, without `--all`.
FIND_DAYS = _env_num("CSM_FIND_DAYS", 21)
#: How long `move` waits for the moved window to print its claude.ai link.
CONNECT_WAIT_S = _env_num("CSM_CONNECT_WAIT", 150.0, float)
POLL_S = _env_num("CSM_POLL", 3.0, float)
#: How long a window started without Remote Control must stay up to count as started.
SETTLE_S = _env_num("CSM_SETTLE", 8.0, float)
TITLE_MAX = 60
#: What a listing ROW shows of a title. Narrower than the stored one so the table fits a
#: phone screen; `--json` keeps the whole thing.
ROW_TITLE = _env_num("CSM_ROW_TITLE", 44)
#: The tmux session a moved window is opened in, as a template over `{name}`, `{handle}` and
#: `{label}` (`Account.tmux_session`). The default keeps each account's moved windows in a
#: session of this tool's own, which is what `stop` recognises as csm's fingerprint.
#:
#: 🛑 SET IT IF YOU ALREADY RUN A TMUX SESSION PER ACCOUNT (added Sun 25 Oct 2026). Then
#: `CSM_TMUX_SESSION='claude-{handle}'` puts a moved window in the session you already
#: attach to, and -- the part that matters -- lets `stop` still see the windows moved before
#: you set it. Changing this while a moved window is open hides that window from `stop`,
#: which then says csm has moved nothing here; close those windows first, or name the
#: spelling they were opened under. Whatever it produces is sanitised the same way, and the
#: `moved-<id8>` window name and the pid proof are unchanged, so a session of yours holding
#: windows of your own is still never a window `stop` will touch.
TMUX_SESSION = os.environ.get("CSM_TMUX_SESSION") or "csm-{name}"
#: TEST ONLY. `tmux -L <socket>` on every call, so a test suite drives a private tmux
#: server: the fixtures' session names are the real ones, and on the default socket a
#: `stop` test would kill your own windows.
TMUX_SOCKET = os.environ.get("CSM_TMUX_SOCKET") or ""
#: 🛑 How long one `tmux` client may take to answer. Every other subprocess call in this
#: file carries a timeout and `tmux()` did not, while `wait_window` — the loop every revive
#: and every move waits in — only ever checks its deadline BETWEEN captures: one blocking
#: tmux client was an unbounded hang inside a bounded wait. Generous, because the calls are
#: local and cheap; it is a bound, not a budget.
TMUX_TIMEOUT_S = _env_num("CSM_TMUX_TIMEOUT_S", 20.0, float)
#: TEST ONLY. Forces the answer of the credential-existence probe (`true` / `false` /
#: `unknown` / `off`). It announces itself on stderr and in the log on EVERY run while it
#: is set: a stale export must never switch a safety check off in silence.
LOGIN_PROBE = (os.environ.get("CSM_LOGIN_PROBE") or "").strip().lower()
LOGIN_PROBE_VALUES = {"true": True, "false": False, "unknown": None, "off": None}

#: 🛑 How ssh is invoked for `--machine` / `--ssh`. BatchMode and a connect timeout are the
#: default on purpose: this tool is run from hooks and scheduled checks, and a plain `ssh`
#: that meets a host it has no key for sits on a password prompt forever — nothing times it
#: out, and the check that called it never returns.
SSH_CMD = os.environ.get("CSM_SSH_CMD") or "ssh -o BatchMode=yes -o ConnectTimeout=15"
#: How to invoke this tool ON the other machine. `shlex.split`, then every token quoted, so
#: a multi-word command (a wrapper that sets the other machine's own environment) survives.
#: Unset, the remote's widened PATH is tried first and a clone beside it second.
#: A token may begin `~/` or `$HOME/`, which means the home of the machine it runs ON —
#: see `_remote_word`, and `REMOTE_FALLBACK` just below, which is the same idea.
REMOTE_CMD = os.environ.get("CSM_REMOTE_CMD") or ""
REMOTE_FALLBACK = "$HOME/git/claude-session-mover/" + PROG
#: How `lsof` is invoked. Only `revive` asks it, and only to answer one question — which
#: folder a running Remote Control SERVER is serving, which is nowhere in its argv. TEST
#: USE TOO: a fixture world has no real servers in it, so the suite points this at a
#: stand-in rather than at the machine's own process table.
LSOF_BIN = os.environ.get("CSM_LSOF") or "lsof"
#: The interpreter the remote HELPER is piped to (`find`, `--from-machine`, `--mirror-cwd`).
#: The system python, not this process's: the helper is standard-library-only on purpose so
#: a machine with no toolchain installed still answers. Nothing of this file goes over.
REMOTE_PYTHON = os.environ.get("CSM_REMOTE_PYTHON") or "/usr/bin/python3"

#: The apiError an assistant line carries when the account hit a limit. Its
#: `apiErrorParams.rate_limit_info` has `rateLimitType` and `resetsAt`; when that is
#: missing the line (or its message) may carry `quotaLimits.resetsAt` instead. All three
#: names have been seen in the wild, so a tool that knows only one under-reports.
QUOTA_ERRORS = ("usage_limit_reached", "rate_limit_error", "rate_limit_exceeded")
#: A `system` line carrying this marker means the session was ended or archived from the
#: app. Such a row is shown as "closed", not "ended": resuming it is rarely what you want.
ENDED_REMOTELY = "code 4090"
#: 🛑 WHICH LIMIT IT IS, BECAUSE WAITING ONLY CLEARS SOME OF THEM. `(class, matcher, does
#: waiting clear it)`, read off the stop line's own text — the only place the distinction
#: appears, since `rateLimitType` says which WINDOW (`five_hour` / `seven_day`) and not
#: which kind of wall. A session or weekly limit lifts at its reset; a monthly spend cap, a
#: credit balance and a per-model limit do not, and telling someone to wait for one of
#: those spends the wait and then another failed turn.
#: ⚠️ THE ORDER IS LOAD-BEARING: the monthly-spend text also contains the words "your
#: session limit resets", so monthly has to be tested before session.
#: Lifted from the fleet's own parked-session classifier, which was written from a measured
#: table of 21 real parks (`claude_parked`, Wed 7 Oct 2026: 10 monthly spend, 3 usage
#: credits, 2 model limit, the rest session/weekly).
LIMIT_CLASSES = (
    ("monthly-spend", re.compile(r"hit your monthly spend limit", re.I), False),
    ("weekly", re.compile(r"hit your weekly limit", re.I), True),
    ("session", re.compile(r"hit your session limit", re.I), True),
    ("credits", re.compile(r"out of usage credits", re.I), False),
    ("model", re.compile(r"reached your .{0,20}limit\b.{0,40}Switch to another model",
                         re.I | re.S), False),
)
#: 🛑 What may be passed to `--model`. An assistant line that carries an apiError names its
#: model `<synthetic>`, and the out-of-quota line, the LAST line of exactly the session you
#: want to move, is one. `claude --model '<synthetic>'` refuses to start, so a model is
#: taken only from a clean assistant line, and only when it looks like a model id.
MODEL_RE = re.compile(r"[A-Za-z0-9][A-Za-z0-9._\[\]-]{1,63}")
NAME_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$")
#: 🛑 An account HANDLE: one lower-case token, never all digits, never leading-hyphen. The
#: shape is enforced where the handle is read, not assumed, because `resolve` has an exact
#: rung for it and a listing prints it: an all-digit handle would make `--to 2` resolve to
#: an account while `--to 2` is otherwise refused as a row number, a handle with a space
#: would break every table that pads by it, and a leading hyphen reads as a flag.
HANDLE_RE = re.compile(r"^(?![0-9]+$)[a-z0-9][a-z0-9-]{0,31}$")
#: A WHOLE session id. Typed in full it names one file and nothing else, so `move` looks
#: for it however old that file is: a caller moving a long-idle session names it by its id,
#: and on a busy machine the newest few hundred transcripts can be a fortnight.
FULL_ID_RE = re.compile(r"^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$")
URL_RE = re.compile(r"(?:cse_|session_)([A-Za-z0-9]{10,})")
LINK_RE = re.compile(r"https://claude\.ai/code/session_[A-Za-z0-9]+")
#: 🛑 HOW A claude.ai LINK FINDS ITS TRANSCRIPT WITH NOTHING RUNNING. A Remote Control
#: session's local id is not random: the CLI derives it from the bridge session's own API
#: url, `uuid5(BRIDGE_NS, BRIDGE_NAME % bare)`, where `bare` is the id the claude.ai
#: `session_X` link and the bridge's `cse_X` share (one id, a swapped prefix). So the
#: transcript of a session that is no longer running can be COMPUTED from the link alone:
#: no registry row, no process, no network — which is the only way to reach it, because a
#: Remote-Control server child's transcript carries no bridge id of its own and a dead
#: session leaves no registry row.
#: Measured on CLI 2.1.312, Wed 28 Oct 2026: the constant is in the bundle verbatim (twice,
#: beside the resume-argument parser) and byte-identical in 2.1.310 and 2.1.311 while the
#: minified identifiers around it change — so `canary` matches the CONSTANT, never a
#: function name. 37/37 live registry rows carrying both ids derive exactly, and 0/37 match
#: any other name form (the bare id, `cse_<bare>`, `session_<bare>`, the claude.ai url, a
#: trailing slash). Two pinned pairs: `cse_01PHXskvoLtckdvqFv3F8rei` →
#: `bf974a77-c0b0-5763-81be-f057a3dc7e57`, `cse_01PHXskvDdMLxdjXDuoZkBpF` →
#: `38ffa06c-4d9a-5981-96b0-a3447ac0c094`.
#: ⚠️ IT IS THE DEFAULT API HOST'S DERIVATION. A CLI pointed at another `ANTHROPIC_BASE_URL`,
#: or one whose `CLAUDE_CODE_REMOTE_SESSION_ID` is set (hashed verbatim, with no url around
#: it), derives something else. That is why a derived id is only ever used as an EXACT match
#: against a transcript that is really on disk, and is never handed to the id-prefix or
#: title rungs: a wrong derivation must come back as "no transcript for that link", never as
#: somebody else's session. See `derive_local_id` and `pick_resolved`.
BRIDGE_NS = "3ab19d7e-9f35-45c2-926e-75e271cc60b3"
BRIDGE_NAME = "https://api.anthropic.com/v1/code/sessions/cse_%s"
#: The CLI's own rule for finding the session id in whatever was pasted: split on `/`, `?`
#: and `#`, then take the first segment that is ENTIRELY a `session_`/`cse_` id. Stricter
#: than `URL_RE`, which finds such an id anywhere in a string, on purpose: the derivation
#: has to agree with the CLI character for character or it names another file.
SPEC_SEG_RE = re.compile(r"^(?:session|cse)_[A-Za-z0-9_]+$")
#: A spacesheep session page. Measured Wed 28 Oct 2026: sessionpipe's `claude-code` session
#: id IS the local transcript id — `…/sessions/claude-code/bf974a77-c0b0-5763-81be-f057a3dc7e57`
#: is the page of `session_01PHXskvoLtckdvqFv3F8rei`, whose derived local id is that uuid —
#: so such a link names the transcript directly and needs no arithmetic.
SHEEP_SESSION_RE = re.compile(
    r"spacesheep\.dev/sessions/claude-code/"
    r"([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})")
#: How much of the CLI bundle `canary` reads at a time, with a needle-sized overlap. The
#: bundle is ~290 MB (measured 2.1.312: 287 MB, the constant at offset 226,593,890) and the
#: engine must stay usable in a 3.7 process, so it is never read whole — and the verdict is
#: cached per CLI version, so it is normally not read at all. See `canary`.
CANARY_CHUNK = _env_num("CSM_CANARY_CHUNK", 1 << 20)
PERM_RE = re.compile(rb'"permissionMode"\s*:\s*"([A-Za-z]+)"')
#: Tool names of the form `mcp__<server>__<tool>`; a server named `claude_ai_<Connector>`
#: is a claude.ai connector, which belongs to the ACCOUNT and not to any config home.
MCP_TOOL_RE = re.compile(rb'"mcp__([A-Za-z0-9_.-]+?)__')
CONNECTOR_PREFIX = "claude_ai_"

#: 🛑 Permission modes WEAKEST → STRONGEST. This is a strength order, not the CLI's own
#: list order, and `resolve_mode` never moves a session down it. `manual` is the settings
#: schema's own alias for `default` (and the label the claude.ai picker shows).
MODE_ORDER = ("plan", "default", "acceptEdits", "auto", "dontAsk", "bypassPermissions")
MODE_ALIASES = {"manual": "default"}
MODES = MODE_ORDER
#: The only recorded modes a stronger configured default may replace. `plan` and
#: `acceptEdits` are chosen deliberately (shift+tab, or a flag) and are left alone; `auto`
#: and `default` are what a session records by accident — a worker started by a Remote
#: Control server records the mode the claude.ai session record holds, not the one its
#: server was started with.
RAISE_FROM = ("", "default", "auto")

#: 🛑 Removed from the environment of the moved session: the WHOLE `CLAUDE*` and
#: `ANTHROPIC*` families, by prefix, plus the two provider variables that carry neither
#: prefix. A list of NAMES cannot be closed under names that do not exist yet — the CLI
#: reads hundreds of distinct CLAUDE* and dozens of ANTHROPIC* variables — and each name a
#: list misses is a real outcome:
#:  * a credential (`CLAUDE_CODE_OAUTH_TOKEN`, `ANTHROPIC_API_KEY`, `ANTHROPIC_AUTH_TOKEN`,
#:    and others) OUTRANKS the target home's own login: the session moves, the quota does
#:    not, and the move reports success;
#:  * a provider switch (`ANTHROPIC_BASE_URL`, `CLAUDE_CODE_USE_BEDROCK`,
#:    `CLAUDE_CODE_USE_VERTEX`, …) sends the moved window somewhere else entirely, so it
#:    spends neither account's subscription;
#:  * identity variables (`CLAUDECODE`, `CLAUDE_PID`, `CLAUDE_CODE_SESSION_*`, the bridge
#:    ones) make the child believe it is the process that launched it, which breaks
#:    self-detection and `--stop-source`;
#:  * preference variables (`ANTHROPIC_MODEL`, `CLAUDE_CODE_MAX_OUTPUT_TOKENS`, …) leak the
#:    mover's own settings into someone else's session.
#: Re-verify the families against a CLI build with:
#:   strings <the CLI binary> | grep -oE '\b(CLAUDE|ANTHROPIC)[A-Z0-9_]*' | sort -u | wc -l
SCRUB_PREFIXES = ("CLAUDE", "ANTHROPIC")
SCRUB_EXACT = frozenset({"CLOUD_ML_REGION", "AWS_BEARER_TOKEN_BEDROCK"})
#: Put back by name, deliberately and visibly: `CSM_KEEP_ENV`, a comma list. Empty by
#: default; `CSM_*` is outside both families already, and `CLAUDE_CONFIG_DIR` is set
#: afterwards from the plan, never inherited. A name outside the two families is dropped
#: here rather than honoured, so this knob cannot become a general allowlist.
#: ⚠️ The scrub is two families plus two names, NOT a general cleanout: AWS_PROFILE,
#: GOOGLE_APPLICATION_CREDENTIALS and the rest of your own auth survive, because that is
#: how your own work inside the moved session keeps working.
#: What it is for: a tool INSIDE the moved session that needs the same input this one had
#: — most usefully the path of the accounts file, which is a path and not a credential.
KEEP_EXACT = frozenset(
    x for x in (y.strip() for y in (os.environ.get("CSM_KEEP_ENV") or "").split(","))
    if x and x.startswith(SCRUB_PREFIXES))
#: 🛑 DROPPED FROM THE MOVED SESSION BY NAME, although they are `CSM_*` and the scrub does
#: not touch that prefix: the test-only switches. A stale export of one of these inside a
#: moved window would force a credential probe's answer, or make "the other machine" this
#: process, in a session nobody is watching. `CSM_TMUX_SOCKET` is NOT one of them — the
#: suite needs it to reach the window it just opened.
SCRUB_TEST_ONLY = frozenset({"CSM_LOGIN_PROBE", "CSM_REMOTE_LOCAL", "CSM_REMOTE_HOME"})

#: Claude Code's versioned binary lives under this path segment. A Remote-Control-spawned
#: worker runs as that binary, a terminal session as `claude`; both are the CLI, and
#: nothing else counts (see `is_claude_exe`).
CLAUDE_VERSIONS_DIR = "/.local/share/claude/versions/"
#: Per-session data the CLI keeps OUTSIDE `projects/`, keyed by the session id. Copied
#: additively, never overwriting.
#: `<home>/file-history/<id>/` is the file-edit history `/rewind` restores from — verified
#: on 2.1.300, where every config home had it. `<home>/tasks/<id>/` is read from the config
#: home by the CLI's own read-allowlist, but on 2.1.300 a session's task OUTPUT is written
#: outside the config home (under a cache root keyed on the cwd), so it is carried
#: opportunistically and is usually not there. Neither claim is a measurement of what the
#: resume reads back.
#: 🛑 Nothing else from the home travels: `sessions/`, `session-env/`, `shell-snapshots/`,
#: `jobs/`, `bridge-pointer.json`, `.claude.json` and every credential stay where they are.
SIDE_DATA_DIRS = ("file-history", "tasks")
#: An older CLI filed the same lists as `<home>/todos/<id>-*.json`.
SIDE_DATA_GLOBS = (("todos", "{id}*.json"),)


# --------------------------------------------------------------------------- plumbing

def host() -> str:
    return (socket.gethostname() or "?").split(".")[0]


def machine() -> str:
    """What this machine is called in the accounts file and as a `--machine` target."""
    return MACHINE or host()


def log(msg: str) -> None:
    try:
        LOG.parent.mkdir(parents=True, exist_ok=True)
        with LOG.open("a") as f:
            # `machine()`, not `host()`: the name every other line of output uses, so one
            # machine is one spelling throughout the log and a `grep <machine>` over it is
            # complete. With nothing configured it IS the hostname, so nothing is lost.
            f.write(f"{time.strftime('%Y-%m-%d %H:%M:%S')} "
                    f"[{machine()}:{os.getpid()}] {msg}\n")
    except OSError:
        pass


class Refusal(Exception):
    """A move or a lookup that must not go ahead. The message says what to do instead."""


def die(msg: str) -> None:
    raise Refusal(msg)


def read_json(p: Path):
    try:
        return json.loads(p.read_text())
    except (OSError, ValueError):
        return None


def human_age(epoch: float) -> str:
    d = max(0, int(time.time() - epoch))
    if d < 90:
        return f"{d}s"
    if d < 5400:
        return f"{d // 60}m"
    if d < 172800:
        return f"{d // 3600}h"
    return f"{d // 86400}d"


def file_age_s(p: Path):
    """Seconds since `p` was last written, or None when it cannot be stat'd.

    None is not 0: "I could not look" and "it was written just now" are different answers,
    and a coverage note that conflates them reads as freshness it never measured.
    """
    try:
        return round(time.time() - p.stat().st_mtime, 1)
    except OSError:
        return None


def file_size(p: Path):
    """`p`'s size in bytes, or None when it cannot be stat'd — same rule as `file_age_s`.

    🛑 Unreadable is not empty, and the caller must not have to remember that. A `stat()`
    spelled inline is also a raise waiting to happen on the one path where a raise is
    worst: a transcript that is deleted between a listing and this read would come out of
    `modes --check` as a traceback on stderr, which every scheduled reader of that one line
    reports as a FAULT in the machine rather than a file that moved.
    """
    try:
        return p.stat().st_size
    except OSError:
        return None


def tidy(s: str, n: int = TITLE_MAX) -> str:
    s = unicodedata.normalize("NFC", (s or "").strip())
    s = re.sub(r"\s+", " ", s)
    s = re.sub(r"<[^>]{1,40}>", "", s).strip()   # a system tag or slash command is no title
    return (s[: n - 1] + "…") if len(s) > n else s


def tilde(p) -> str:
    s = str(p)
    h = str(HOME)
    return "~" + s[len(h):] if s == h or s.startswith(h + os.sep) else s


def epoch_s(v) -> float:
    """`resetsAt` as seconds since the epoch, whether it was written in s or ms."""
    if not isinstance(v, (int, float)) or isinstance(v, bool):
        return 0.0
    return v / 1000.0 if v > 1e12 else float(v)


def clock(epoch: float) -> str:
    return time.strftime("%H:%M", time.localtime(epoch)) if epoch else "?"


# --------------------------------------------------------------------------- accounts

ACCOUNTS_HELP = f"""\
Accounts are discovered: ~/.claude is "default" (CLAUDE_CONFIG_DIR unset) and every
~/.claude-<name> directory is "<name>". To name them yourself, or to say which login each
must hold, write {tilde(ACCOUNTS_FILE)} (or point CSM_ACCOUNTS at a file); it then
replaces discovery entirely. `#` comments, one account per line, in either of two
dialects — whitespace-separated, or a TAB-separated table.

SIMPLE, for one machine and a handful of homes:

    # name      home               [expected email]
    default     -                  you@example.com
    work        ~/.claude-work     you@work.example
    personal    ~/.claude-me

`-` (or `default`) is the default home, i.e. CLAUDE_CONFIG_DIR unset.

TABLE, when the same file is read on several machines or by other tools. A line holding a
TAB is a table row. The columns this tool reads are taken by name from a commented header
line when there is one, and otherwise by position: 1 name, 2 email, 3 home, 6 machines,
7 handle. Every other column is ignored by design (the file may belong to another tool).

    # name\temail\thome\tx\tx\tmachines\thandle
    work\tyou@work.example\t~/.claude-work\t-\t-\tlaptop,desktop\twk
    personal\tyou@example.com\t~/.claude-me\t-\t-\tlaptop\tme

  machines  which machines this account is on, comma-separated, matched against
            CSM_MACHINE (default: this machine's short hostname). A row that names no
            machine (`-` or empty) is refused as a move target. A file whose machine names
            this machine is not among lists every account rather than none, so an
            unrecognised CSM_MACHINE cannot read as "nothing here".
  handle    a short alias that resolves wherever the name does, and is what listings
            print. One lower-case token of [a-z0-9-], not all digits, not starting with a
            hyphen, unique in the file. `-` or empty means "no handle".

🛑 `home` in a TABLE may not be `-`, `default` or `~/.claude`: in a table every account
names its own home. `-` means "the default home with CLAUDE_CONFIG_DIR UNSET", and
spelling the default home out is a third thing again — any non-empty value takes the
hashed-Keychain branch and lands on an empty slot that reads exactly like signed out. A
table row that wants the default home is a row that wants a home of its own. (The simple
dialect keeps `-`, where there is one home and it is unambiguous.)

With an expected email, a home signed in as anyone else is refused as a move target,
because the move would spend the wrong quota.
"""


@dataclass
class Account:
    name: str
    home: Path
    default: bool = False
    expect: str = ""
    #: A short alias that resolves like the name, and what a listing prints. "" = none.
    handle: str = ""
    #: The machines this account is on, or None for "the file did not say". `()` means it
    #: said "none", which is a refusal as a move target — not the same as not saying.
    machines: tuple = None
    _oauth: dict = field(default=None, repr=False, compare=False)

    @property
    def label(self) -> str:
        """What to print for this account: the handle when there is one, else the name."""
        return self.handle or self.name

    @property
    def state_file(self) -> Path:
        """`<home>/.claude.json`, except for the default home.

        🛑 With CLAUDE_CONFIG_DIR UNSET the CLI keeps its state file at `~/.claude.json`,
        OUTSIDE `~/.claude`. Spelling the default home out (`CLAUDE_CONFIG_DIR=~/.claude`) is
        a different account as far as the CLI is concerned: the state file moves inside the
        directory, and on macOS the Keychain item becomes `Claude Code-credentials-<hash>`
        instead of the bare `Claude Code-credentials`, so it reads as signed out. That is
        why a move into the default home UNSETS the variable (`config_dir` is None).
        """
        return HOME / ".claude.json" if self.default else self.home / ".claude.json"

    @property
    def config_dir(self):
        return None if self.default else str(self.home)

    @property
    def projects(self) -> Path:
        return self.home / "projects"

    @property
    def tmux_session(self) -> str:
        """The tmux session a moved window of this account's is opened in (`CSM_TMUX_SESSION`).

        A template with no placeholder is still a name, and would then be ONE session for
        every account — legal, and the caller's business. A template naming something else
        (`{foo}`) falls back to the default rather than refusing: a bad knob must not take
        `list` and `modes` down with it, and `stop`'s own proof is the window name and the
        pid, not this string. tmux allows neither `.` nor `:` in a session name, so the
        result is sanitised whatever the template said — and a LEADING HYPHEN is dropped,
        because the name is passed to `tmux -s` and `-t` and one there would be read as a
        flag. A template that sanitises away to nothing falls back like a broken one.
        """
        default = "csm-" + self.name
        try:
            s = TMUX_SESSION.format(name=self.name, handle=self.handle or self.name,
                                    label=self.label)
        except (KeyError, IndexError, ValueError):
            s = default
        s = re.sub(r"[^A-Za-z0-9_-]", "-", s).lstrip("-")
        return s or re.sub(r"[^A-Za-z0-9_-]", "-", default)

    def oauth(self) -> dict:
        """The login this home HOLDS (a plain file read; credentials are never touched)."""
        if self._oauth is None:
            d = read_json(self.state_file)
            oa = d.get("oauthAccount") if isinstance(d, dict) else None
            self._oauth = oa if isinstance(oa, dict) else {}
        return self._oauth

    @property
    def email(self) -> str:
        e = self.oauth().get("emailAddress")
        return e.strip() if isinstance(e, str) else ""

    @property
    def org(self) -> str:
        o = self.oauth().get("organizationUuid")
        return o if isinstance(o, str) else ""

    @property
    def credential_service(self) -> str:
        """The macOS Keychain service name holding this home's login.

        🛑 `Claude Code-credentials` when CLAUDE_CONFIG_DIR is unset, and
        `Claude Code-credentials-<8 hex>` otherwise, where the hex is the start of
        sha256 over the NFC form of the LITERAL string the variable is set to — no
        realpath, no trailing-slash trimming, no `~` expansion. So `~/.claude-work` and
        `~/.claude-work/` are two different logins, and renaming a home orphans its login
        until that Keychain item is copied across (copy, verify the new name serves, only
        then delete the old one). The item's account is `$USER`.
        """
        if self.default:
            return "Claude Code-credentials"
        return keychain_service_for(str(self.home))


def keychain_user() -> str:
    """The Keychain item's ACCOUNT field, spelled the way the CLI spells it.

    🛑 `$USER`, and when that is not exported the OS user name — NOT the sentinel. The CLI
    falls back to the password database before it gives up, and `claude-code-user` is only
    what it uses when even that fails or the name holds an odd character. Reaching for the
    sentinel too early asks the Keychain about an account that does not exist, which comes
    back `errSecItemNotFound` and reads as "signed out" for every home at once — exactly
    the wrong answer in the unattended contexts (a container, `env -i`, some CI runners)
    where USER tends to be missing.
    """
    u = os.environ.get("USER") or ""
    if not u:
        try:
            u = pwd.getpwuid(os.getuid()).pw_name or ""
        except (OSError, KeyError, AttributeError):
            u = ""
    return u if re.match(r"^[A-Za-z0-9._-]+$", u) else "claude-code-user"


def credential_file(acct: Account) -> Path:
    """Where the login lives when there is no OS keychain (Linux, containers)."""
    return acct.home / ".credentials.json"


def keychain_service_for(literal: str) -> str:
    return "Claude Code-credentials-" + hashlib.sha256(
        unicodedata.normalize("NFC", literal).encode("utf-8")).hexdigest()[:8]


def credential_services(acct: Account) -> list:
    """`[(the literal spelling, the Keychain service name)]` to probe, in order.

    🛑 The service name is built from the LITERAL string `CLAUDE_CONFIG_DIR` held when the
    login was made, so `~/.claude-work` and `~/.claude-work/` are two different items.
    Every path csm holds has been through `expanduser`, which drops a trailing slash, so a
    home signed in WITH one would read as signed out and the move would refuse a target
    that is perfectly usable. One extra probe covers that one spelling.

    🛑 One extra, and no more. Realpath and other speculative spellings are not tried:
    each `security` call is another chance to block on a locked keychain over ssh, and an
    unattended run has nobody to unlock it.
    """
    if acct.default:
        return [("", "Claude Code-credentials")]
    base = str(acct.home)
    out = [("", keychain_service_for(base))]
    if not base.endswith(os.sep):
        out.append((base + os.sep, keychain_service_for(base + os.sep)))
    return out


def credential_present(acct: Account):
    """`True` signed in, `False` the credential is gone, `None` could not look.

    🛑 Existence only. The value is never read, printed, logged or cached: on macOS that
    means the exit code of `security find-generic-password -a <user> -s <service>` with no
    `-w` and no `-g` (both print the secret), under a hard timeout — an item whose ACL does
    not cover /usr/bin/security raises a dialog that would block an unattended run, and
    over ssh the login keychain often cannot be read at all. Exit 44 (errSecItemNotFound)
    is a real "signed out"; every other non-zero answer is UNKNOWN.

    🛑 Unreadable is never promoted to signed out. Reading "I could not look" as "you are
    logged out" is how a check tells people to sign in to accounts that are perfectly fine.
    """
    if LOGIN_PROBE:
        if LOGIN_PROBE not in LOGIN_PROBE_VALUES:
            die("CSM_LOGIN_PROBE=%s is not one of %s" % (
                LOGIN_PROBE, ", ".join(sorted(LOGIN_PROBE_VALUES))))
        msg = ("CSM_LOGIN_PROBE=%s: the credential store was NOT asked about %s"
               % (LOGIN_PROBE, acct.name))
        print("csm: " + msg, file=sys.stderr)
        log(msg)
        return LOGIN_PROBE_VALUES[LOGIN_PROBE]
    if sys.platform == "darwin":
        gone = None
        for literal, service in credential_services(acct):
            try:
                r = subprocess.run(["security", "find-generic-password",
                                    "-a", keychain_user(), "-s", service],
                                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                                   timeout=10)
            except (OSError, subprocess.SubprocessError):
                return None
            if r.returncode == 0:
                if literal:
                    msg = ("%s is signed in under the Keychain item for %r, not %r: the "
                           "literal CLAUDE_CONFIG_DIR it was signed in with differs from "
                           "the path csm uses, which is fine here but will orphan the "
                           "login the day that home is renamed"
                           % (acct.name, literal, str(acct.home)))
                    print("csm: " + msg, file=sys.stderr)
                    log(msg)
                return True
            if r.returncode == 44:      # errSecItemNotFound: a real "signed out"
                gone = False
                continue
            return None                 # 36 = keychain locked, 51 = no access, …
        return gone
    try:
        return credential_file(acct).is_file()
    except OSError:
        return None


def signin_gesture(acct: Account) -> str:
    return "claude" if acct.default else "CLAUDE_CONFIG_DIR=%s claude" % tilde(acct.home)


def login_usable(acct: Account):
    """`(ok, sentence)` — the tri-state login check both `accounts` and `move` use.

    The state file is NOT the login: `oauthAccount.emailAddress` is the last login the CLI
    saw there, so a home whose credential was removed or expired still names someone. It
    would pass every file check, have its dialogs pre-answered and its transcript written,
    and then fail at the first API call — which is the one outcome a preflight exists to
    prevent. Hence three answers, from one primitive, so the view and the refusal can never
    disagree: signed in / the credential is gone (refuse) / could not look (proceed, warn).
    """
    # 🛑 THE LABEL, like every other sentence a reader sees. These four come back through
    # `check_target`'s refusal and the plan's UNVERIFIED line, beside sentences that name
    # the account by its handle — and one refusal calling one account two different things
    # reads as two accounts.
    who = acct.label
    if not acct.home.is_dir():
        return False, "%s: %s does not exist" % (who, tilde(acct.home))
    if not acct.email:
        return False, ("%s (%s) holds no login. Sign it in once: %s, then /login"
                       % (who, tilde(acct.home), signin_gesture(acct)))
    cred = credential_present(acct)
    if cred is False:
        where = ("the Keychain item %s" % acct.credential_service if sys.platform == "darwin"
                 else tilde(credential_file(acct)))
        return False, ("%s still names %s in its state file, but its credential is GONE "
                       "(%s): the move would copy the session into a home that cannot talk "
                       "to Claude. Sign it in again: %s, then /login"
                       % (who, acct.email, where, signin_gesture(acct)))
    if cred is None:
        return True, ("⚠ UNVERIFIED: %s names %s, but the credential store could not be "
                      "asked, so whether that login still works is unknown"
                      % (who, acct.email))
    return True, ""


#: The settings files one config home reads, in the order they are layered: each later
#: file wins over the earlier one, PER KEY PATH.
SETTINGS_FILES = ("settings.json", "settings.local.json")


def merge_settings(base: dict, over: dict) -> dict:
    """`over` layered onto `base` per KEY PATH: nested objects merge, leaves replace.

    🛑 Not `dict.update`. The CLI resolves each setting by its own key path across the
    sources (`permissions.defaultMode`, `permissions.disableAutoMode`, `env.<name>` …), so
    a later file that defines only `permissions.allow` leaves `permissions.defaultMode`
    standing. A top-level update instead replaces the whole `permissions` object, which is
    how an accumulated `settings.local.json` allow-list — the common shape — silently
    erases the permission mode and the memory store the home actually reads.
    """
    out = dict(base)
    for k, v in over.items():
        if isinstance(v, dict) and isinstance(out.get(k), dict):
            out[k] = merge_settings(out[k], v)
        else:
            out[k] = v
    return out


def effective_settings(home: Path) -> dict:
    """`settings.json` with `settings.local.json` layered over it, per key path.

    A plain read, so a home whose `settings.json` is a SYMLINK to one shared file is
    followed — that is the usual way several homes are made to share one settings file, and
    a value must never be inferred from which home this is.
    """
    out = {}
    for name in SETTINGS_FILES:
        d = read_json(home / name)
        if isinstance(d, dict):
            out = merge_settings(out, d)
    return out


def looks_like_home(p: Path) -> bool:
    return any((p / x).exists() for x in ("projects", ".claude.json", "sessions", "settings.json"))


#: The TABLE dialect's columns: what this tool calls each one, the names a commented header
#: line may give it, and where it sits when there is no header (0-based). Columns 4, 5 and 8
#: of such a table belong to whatever other tool wrote it and are ignored by design — this
#: tool derives a tmux session name from the account name (`Account.tmux_session`) rather
#: than reading one, so a `tmux`-ish column is never consulted.
TABLE_COLUMNS = (("name", ("name", "key", "n"), 0),
                 ("email", ("email",), 1),
                 ("home", ("home",), 2),
                 ("machines", ("machines",), 5),
                 ("handle", ("handle",), 6))
#: What `home` may NOT be in a table row. See `ACCOUNTS_HELP`.
NO_DEFAULT_HOME = ("-", "default", "~/.claude", "$HOME/.claude")


def _table_header(lines: list) -> dict:
    """{column name: index} from a commented header line, or `{}` when there is none.

    Read first so a table that re-orders or inserts a column is survived by name. A comment
    line counts as the header when it splits on TABs into something naming at least `email`
    and `home` — the prose above a table says "columns" in sentences, and must not be read
    as one.
    """
    for raw in lines:
        s = raw.strip()
        if not s.startswith("#") or "\t" not in s:
            continue
        cells = [c.strip().strip("#").strip().lower() for c in s.lstrip("#").split("\t")]
        idx = {}
        for want, aliases, _pos in TABLE_COLUMNS:
            for i, cell in enumerate(cells):
                if cell in aliases:
                    idx[want] = i
                    break
        if "email" in idx and "home" in idx:
            return idx
    return {}


def parse_accounts_file(path: Path) -> list:
    """The accounts file, in file order. Two dialects, chosen per line; see `ACCOUNTS_HELP`.

    A row this cannot parse is a REFUSAL naming the line, never a guess: half an account
    would move a session onto a home that is nobody's. The one exception is a handle whose
    SHAPE is wrong — that row is dropped, with a line in the log, because the file may be
    shared with other tools and one unusable alias is not a reason to refuse every command.
    """
    out, names, handles = [], {}, {}
    try:
        text = path.read_bytes().decode("utf-8")
    except UnicodeDecodeError:
        raise Refusal(f"{tilde(path)} is not UTF-8 text, so it cannot be an accounts file")
    except OSError as e:
        raise Refusal(f"{tilde(path)} could not be read: {e}")
    raws = text.splitlines()
    header = _table_header(raws)
    dialects = {}
    for n, raw in enumerate(raws, 1):
        # 🛑 TABS ARE NOT TRAILING WHITESPACE. A plain `rstrip()` eats the empty cells at
        # the end of a table row, and then a row whose `machines` cell is EMPTY — which
        # the file means as "on no machine", a refusal as a move target — came back as
        # "the column is not there", which means the opposite: every row is a target.
        # Spaces and a stray carriage return go; the column structure stays. The simple
        # dialect splits on whitespace anyway, so keeping a tab costs it nothing.
        line = raw.split("#", 1)[0].rstrip(" \r\n")
        if not line.strip():
            continue
        if "\t" in line and len([c for c in line.split("\t")]) >= 3:
            dialect, acct = "table", _table_row(path, n, line, header)
        else:
            dialect, acct = "simple", _simple_row(path, n, line, raw)
        dialects.setdefault(dialect, n)
        if len(dialects) > 1:
            other = "table" if dialect == "simple" else "simple"
            raise Refusal(
                f"{tilde(path)}:{n}: this is a {dialect} line, but line {dialects[other]} is "
                f"a {other} one. One accounts file is one dialect — a tab-separated table or "
                f"`name home [email]` lines, not both")
        if acct is None:
            continue                     # a bad handle shape: dropped, said in the log
        if acct.name.lower() in names:
            raise Refusal(f"{tilde(path)}:{n}: the name {acct.name!r} is used twice "
                          f"(line {names[acct.name.lower()]} has it too)")
        names[acct.name.lower()] = n
        if acct.handle:
            if acct.handle in handles:
                raise Refusal(
                    f"{tilde(path)}:{n}: the handle {acct.handle!r} is used twice (line "
                    f"{handles[acct.handle]} has it too): `--to {acct.handle}` would answer "
                    f"with whichever came first instead of asking which you mean")
            handles[acct.handle] = n
        out.append(acct)
    return out


def _simple_row(path: Path, n: int, line: str, raw: str):
    parts = line.split()
    if len(parts) not in (2, 3):
        raise Refusal(f"{tilde(path)}:{n}: expected `name home [email]`, got {raw.strip()!r}")
    name, home = parts[0], parts[1]
    if not NAME_RE.match(name):
        raise Refusal(f"{tilde(path)}:{n}: {name!r} is not a usable account name "
                      "(letters, digits, '.', '_', '-')")
    email = parts[2] if len(parts) == 3 else ""
    if home in ("-", "default"):
        return Account(name, HOME / ".claude", default=True, expect=email)
    return Account(name, Path(os.path.expanduser(home)), expect=email)


def _table_row(path: Path, n: int, line: str, header: dict):
    cells = [c.strip() for c in line.split("\t")]

    def cell(want, pos):
        """The cell, or None when this row has no such column at all."""
        i = header.get(want, pos)
        return cells[i] if 0 <= i < len(cells) else None

    get = {}
    for want, _aliases, pos in TABLE_COLUMNS:
        got = cell(want, pos)
        get[want] = "" if got is None else got
    #: 🛑 "The column is not there" is not "the column says none". A narrow table (name,
    #: email, home and nothing else) has not said which machines its accounts are on, so
    #: every one of them is here — while a `machines` cell spelled `-` says, deliberately,
    #: that this account is on no machine and is not a move target.
    said_machines = cell("machines", 5) is not None
    name = get["name"]
    if not NAME_RE.match(name):
        raise Refusal(f"{tilde(path)}:{n}: {name!r} is not a usable account name "
                      "(letters, digits, '.', '_', '-')")
    home = get["home"]
    # 🛑 Not the default home, and not the default home spelled out. See `ACCOUNTS_HELP`.
    if (home in NO_DEFAULT_HOME or not home
            or same_path(os.path.expanduser(home), HOME / ".claude")):
        raise Refusal(
            f"{tilde(path)}:{n}: {name!r} names no home of its own ({home!r}). In a table "
            f"every account names its own home: write ~/.claude-{name}. Not the default "
            f"home and not '~/.claude' spelled out — any non-empty CLAUDE_CONFIG_DIR takes "
            f"the hashed-Keychain branch and lands on an empty slot that reads exactly like "
            f"signed out, and an empty one is a home that is nobody's")
    mcell = get["machines"]
    machines = (tuple(m.strip() for m in ("" if mcell == "-" else mcell).split(",")
                      if m.strip()) if said_machines else None)
    handle = "" if get["handle"] == "-" else get["handle"]
    if handle and not HANDLE_RE.match(handle):
        log(f"{tilde(path)}:{n}: handle {handle!r} is not one lower-case token of [a-z0-9-] "
            f"(and may not be all digits) — row {name!r} SKIPPED")
        return None
    return Account(name, Path(os.path.expanduser(home)), expect=get["email"],
                   handle=handle, machines=machines)


def discover_accounts() -> list:
    out = []
    seen = set()
    d = HOME / ".claude"
    if d.is_dir() or (HOME / ".claude.json").is_file():
        out.append(Account("default", d, default=True))
        seen.add(os.path.realpath(str(d)))
    cands = sorted(HOME.glob(".claude-*"))
    env = os.environ.get("CLAUDE_CONFIG_DIR")
    if env:
        cands.append(Path(os.path.expanduser(env)))     # the home this command runs under
    used = {a.name.lower() for a in out}
    for p in cands:
        real = os.path.realpath(str(p))
        if real in seen or not p.is_dir() or not looks_like_home(p):
            continue
        seen.add(real)
        name = p.name[len(".claude-"):] if p.name.startswith(".claude-") else p.name.lstrip(".")
        if not name or name.lower() in used or not NAME_RE.match(name):
            name = re.sub(r"[^A-Za-z0-9._-]", "-", p.name.lstrip(".")) or "home"
        used.add(name.lower())
        out.append(Account(name, p))
    return out


def accounts_here(rows: list) -> list:
    """Only the accounts the file puts on THIS machine, when the file says.

    🛑 A machine the file does not name must still list its sessions. Filtering to nothing
    reads exactly like "there are no sessions anywhere", which is the one answer that is
    never useful — so an unrecognised `CSM_MACHINE` falls back to every row, and the caller
    still skips a home that is not on disk.

    ⚠️ A row that names NO machine is KEPT. It is not an account this machine can move a
    session to, and `check_target` refuses it saying so — but dropping it here would make
    `--to <that row>` answer "is no account here" about a row the file plainly names, which
    sends somebody looking for a typo instead of at the `machines` column.
    """
    if not any(a.machines is not None for a in rows):
        return rows                        # no machines column: this file is one machine's
    me = machine()
    matched = [a for a in rows if a.machines is None or me in a.machines]
    if not matched:
        return list(rows)                  # this machine is in no row: show every one
    keep = {id(a) for a in matched}
    return [a for a in rows if id(a) in keep or not a.machines]


def load_accounts() -> list:
    if ACCOUNTS_FILE.is_file():
        return accounts_here(parse_accounts_file(ACCOUNTS_FILE))
    return discover_accounts()


def resolve(spec: str, accts: list) -> Account:
    """One account from what was typed. THE LADDER, first unique win; never a guess.

      1. exact name (case-insensitive)
      2. exact email: the login a home holds, or the one the accounts file expects
      3. exact handle, when the accounts file gives one
      4. a bare number is REFUSED unless it is literally a name: a position in a list
         changes whenever an account is added or removed, so it cannot be trusted to mean
         the same account twice
      5. unique prefix of a name or a handle
      6. unique substring of a name, a handle or an email
    """
    s = (spec or "").strip()
    names = ", ".join(a.label for a in accts) or "(none found: see `csm accounts`)"
    if not s:
        die(f"name an account: {names}")
    low = s.lower()
    hit = [a for a in accts if a.name.lower() == low]
    if hit:
        return hit[0]
    hit = [a for a in accts if low in ({a.email.lower(), a.expect.lower()} - {""})]
    if len(hit) == 1:
        return hit[0]
    if len(hit) > 1:
        die(f"{s} is signed in to {len(hit)} homes ({', '.join(a.label for a in hit)}): "
            "name the one you mean")
    # 🛑 The handle is an EXACT rung of its own, above every fuzzy one, because it is what
    # the listing prints and therefore what gets typed back. `parse_accounts_file` refuses
    # a file with two of them, so this can never be the ambiguous case.
    hit = [a for a in accts if a.handle and a.handle.lower() == low]
    if hit:
        return hit[0]
    if s.isdigit():
        die(f"accounts are named, never numbered (a position changes whenever an account "
            f"is added or removed): use one of {names}")
    tests = (lambda a: a.name.lower().startswith(low) or a.handle.lower().startswith(low),
             lambda a: low in a.name.lower() or low in a.email.lower()
             or (bool(a.handle) and low in a.handle.lower()))
    for test in tests:
        hit = [a for a in accts if test(a)]
        if len(hit) == 1:
            return hit[0]
        if len(hit) > 1:
            die(f"'{s}' matches {len(hit)} accounts: {', '.join(a.label for a in hit)}: "
                "say which")
    die(f"'{s}' is no account here. The accounts are: {names}")
    raise AssertionError("unreachable")


# ------------------------------------------------------------------------- the quota meter

def meters() -> dict:
    """`{account name or handle: {five_hour, seven_day, resets_at, age_s}}`, or `{}` unread.

    🛑 A READING, NEVER A GUESS. `five_hour` and `seven_day` are percent USED; `at` is when
    the reading was taken, read through `epoch_s` so milliseconds survive. A row carrying an
    `error`, or percentages that are not numbers, is dropped rather than read as zero — and
    a file that is not there at all gives `{}`, which every caller must treat as "the meter
    is unread", never as "there is room". Nothing here asks the network: the file is written
    by whatever tool you point `CSM_METERS` at.
    """
    try:
        d = json.loads(METERS_FILE.read_text())
    except (OSError, ValueError):
        return {}
    out = {}
    now = time.time()
    for k, v in (d.items() if isinstance(d, dict) else []):
        if not isinstance(v, dict) or v.get("error"):
            continue
        fh, sd = v.get("five_hour"), v.get("seven_day")
        if isinstance(fh, bool) or isinstance(sd, bool):
            continue
        if not isinstance(fh, (int, float)) or not isinstance(sd, (int, float)):
            continue
        out[str(k)] = {"five_hour": float(fh), "seven_day": float(sd),
                       "resets_at": str(v.get("resets_at") or ""),
                       "age_s": max(0.0, now - epoch_s(v.get("at")))}
    return out


def meter_of(ms: dict, acct: Account):
    """This account's reading: keyed by its name first, then by its handle."""
    if not ms:
        return None
    return ms.get(acct.name) or (ms.get(acct.handle) if acct.handle else None)


def meter_text(m) -> str:
    """One cell for a reading. "unread" is its own answer and is never dressed as 0 %."""
    if not m:
        return "quota unread here"
    stale = ", STALE" if m["age_s"] > METER_MAX_AGE_S else ""
    return (f"5 h {m['five_hour']:.0f}% · week {m['seven_day']:.0f}% used "
            f"(read {human_age(time.time() - m['age_s'])} ago{stale})")


def near_limit(m) -> bool:
    """Is this a FRESH reading at or over either cutoff?

    🛑 A STALE READING IS NEVER NEAR A LIMIT AND NEVER ROOM EITHER. It is unread, and the
    two callers want opposite things from an unread meter: `auto_target` must not pick the
    account, and the plan must not warn about it. Both are served by answering `False`
    here and asking `m["age_s"]` separately, which is why staleness is checked in both
    places and not folded into this one.
    """
    return bool(m) and m["age_s"] <= METER_MAX_AGE_S and (
        m["five_hour"] >= AUTO_FIVE_HOUR_MAX or m["seven_day"] >= AUTO_SEVEN_DAY_MAX)


# --------------------------------------------------------------------- who is running us

_SELF: list = []


def self_session():
    """`(this session's local id, every pid from here up to init)`.

    🛑 "Move THIS session" is the main use from a phone: the agent inside a session runs the
    tool on its own session. So self must be RECOGNISED, and never stopped: stopping it would
    kill the turn that is about to say where the move went. Two signals the CLI puts in a
    session's environment, CLAUDE_CODE_SESSION_ID (the local id, i.e. the transcript's name)
    and CLAUDE_PID (the process `sessions/<pid>.json` is named after), plus the process
    ancestry for a wrapper that drops both. Over ssh neither is set, which is right: the
    session running the tool is then on another machine.
    """
    if _SELF:
        return _SELF[0]
    sid = (os.environ.get("CLAUDE_CODE_SESSION_ID") or "").strip().lower()
    pids = set()
    for var in ("CLAUDE_PID", "CLAUDE_CODE_PARENT_PID"):
        v = (os.environ.get(var) or "").strip()
        if v.isdigit():
            pids.add(int(v))
    pid = os.getpid()
    for _ in range(16):                      # capped: a cycle must not hang a listing
        pids.add(pid)
        try:
            out = subprocess.run(["ps", "-o", "ppid=", "-p", str(pid)], capture_output=True,
                                 text=True, timeout=5).stdout.strip()
        except (OSError, subprocess.SubprocessError):
            break
        if not out.isdigit() or int(out) <= 1 or int(out) in pids:
            break
        pid = int(out)
    _SELF.append((sid, frozenset(pids)))
    return _SELF[0]


# ------------------------------------------------- a link, a bridge id, and its transcript

def bare_bridge_id(spec: str) -> str:
    """The bare claude.ai / bridge session id in `spec`, by the CLI's own rule, or `""`.

    Accepts a claude.ai link, any url carrying such a segment, and a bare `session_X` or
    `cse_X`: the two prefixes are one id with the prefix swapped. ⚠️ The SEGMENT has to be
    the whole id (`SPEC_SEG_RE`, matched per segment, not searched for anywhere in the
    string), because what comes out of it is used as a filename — and a sloppy match names
    a different file. `URL_RE` stays as it is for the listing's own link rung, which
    compares against an id csm read off disk and so cannot invent one.
    """
    for part in re.split(r"[/?#]", (spec or "").strip()):
        if SPEC_SEG_RE.match(part):
            return part.split("_", 1)[1]
    return ""


def derive_local_id(spec: str) -> str:
    """The local transcript id `spec` names, COMPUTED — `""` when it names none.

    Two forms, both measured (see `BRIDGE_NS`):
      * a claude.ai link, a `session_X`/`cse_X` id, or any url carrying such a segment —
        the local id is `uuid5` of the bridge session's own api url;
      * a spacesheep session page — the uuid in it IS the local id.
    The answer is always a version-5 uuid for the first form, so it can never collide with
    a terminal session's random v4 id.
    """
    m = SHEEP_SESSION_RE.search(spec or "")
    if m:
        return m.group(1).lower()
    bare = bare_bridge_id(spec)
    if not bare:
        return ""
    return str(uuidlib.uuid5(uuidlib.UUID(BRIDGE_NS), BRIDGE_NAME % bare))


def answered_here(d: dict, m: dict) -> bool:
    """Is this assistant line the session ANSWERING, as against recording that it did not?

    🛑 TWO KINDS OF NON-ANSWER WEAR A CLEAN LINE'S CLOTHES, and both readers of a transcript
    key "it recovered and answered again" on finding one:
      * an `isApiErrorMessage` line whose `error` is NOT `rate_limit` — an overload, say.
        An error that is not a limit is not the session answering again, which is what the
        clean branch's own comment has always said while the code counted it anyway.
      * a `<synthetic>` line reading "No response requested.", which the CLI writes
        precisely when an injected `isMeta` prompt produced NOTHING. The one line that
        records a non-answer was being read as the answer, which masked a usage-limit stop
        as `finished` (losing its class, window and reset) and a mid-turn kill as `finished`
        too (losing "its last tool call has no recorded result", the one sentence M4 makes
        mandatory). Measured here Wed 28 Oct 2026, CLI 2.1.312: 23 such lines in 20 of the
        1,943 transcripts in the config homes on this machine, every one of them with that
        exact text.
    A line with NO `model` key keeps counting as an answer: `MODEL_RE` is the test for a
    model that is really a model, and absence is not `<synthetic>`.
    """
    if d.get("isApiErrorMessage"):
        return False
    mdl = m.get("model") if isinstance(m, dict) else None
    if isinstance(mdl, str) and not MODEL_RE.fullmatch(mdl):
        return False
    return True


def uuid_version(s: str):
    """The uuid VERSION of a local session id, or `None` when it is not a uuid at all.

    🛑 The one fact about an id that no file has to still exist for. `derive_local_id`
    mints a Remote Control server child's local id as `uuid5` of its bridge session's api
    url, while every other session gets a random `uuid4` — so version 5 is proof that a
    transcript belongs to a child, read off the name alone, with nothing running, no
    registry row and no bridge line left anywhere. `revive_kind` needs it because the four
    places a bare bridge id is written down are all gone for a child that exited cleanly.
    """
    try:
        return uuidlib.UUID(str(s or "")).version
    except (ValueError, AttributeError, TypeError):
        return None


def canary_path(version: str) -> Path:
    return STATE_DIR / ("canary-%s.json" % re.sub(r"[^A-Za-z0-9._-]", "-", version or "?"))


def canary() -> dict:
    """Is `BRIDGE_NS` really in the CLI bundle this machine runs? Asked once per version.

    `{"ok": True | False | None, "version", "where", "why"}`. `None` is "could not look",
    which is never a pass: the caller SAYS the derivation is unverified instead of deriving
    in silence (`spec_notes`).

    🛑 ONCE PER CLI VERSION, NEVER ON EVERY RUN. Every subcommand resolves a spec, and the
    bundle is ~290 MB, so a scan on the resolution path would be paid by every scheduled
    check on this machine. The verdict is cached in the state dir against the bundle's own
    path, size and mtime, so an upgrade — and only an upgrade — scans again (0.22 s and
    69 MB peak RSS, measured on 2.1.312, Wed 28 Oct 2026). The scan reads `CANARY_CHUNK` at
    a time with a needle-sized overlap, so a constant lying across a chunk boundary is
    still found and nothing holds the bundle in memory.
    🛑 And the NEEDLE IS THE CONSTANT, not a function name: the construction around it is
    byte-identical in 2.1.310/311/312 while every minified identifier in it changes.
    """
    ver, where = cli_version()
    out = {"ok": None, "version": ver, "where": where, "why": ""}
    exe = claude_bin()
    real = os.path.realpath(exe) if exe else ""
    if not ver or not real:
        out["why"] = where if not ver else "no `claude` on PATH (and CSM_CLAUDE is not set)"
        return out
    try:
        st = os.stat(real)
    except OSError as e:
        out["why"] = "%s could not be read (%s)" % (tilde(real), e.__class__.__name__)
        return out
    key = {"path": real, "size": st.st_size, "mtime": int(st.st_mtime)}
    cache = canary_path(ver)
    d = read_json(cache)
    if (isinstance(d, dict) and isinstance(d.get("ok"), bool)
            and all(d.get(k) == v for k, v in key.items())):
        out["ok"], out["why"] = d["ok"], str(d.get("why") or "")
        return out
    needle = BRIDGE_NS.encode()
    # ⚠️ Never below twice the needle, whatever the knob says, or the overlap below would
    # eat the whole chunk and the scan would never move forward.
    step = max(len(needle) * 2, int(CANARY_CHUNK))
    hits, carry = 0, b""
    try:
        with open(real, "rb") as f:
            while True:
                buf = f.read(step)
                if not buf:
                    break
                blob = carry + buf
                hits += blob.count(needle)
                carry = blob[-(len(needle) - 1):]
    except OSError as e:
        out["why"] = "%s could not be read (%s)" % (tilde(real), e.__class__.__name__)
        return out
    out["ok"] = hits > 0
    out["why"] = ("the namespace is in %s (%d occurrence%s)"
                  % (tilde(real), hits, "" if hits == 1 else "s") if hits else
                  "the namespace csm derives with is NOT in %s" % tilde(real))
    rec = dict(key)
    rec["ok"], rec["why"], rec["at"] = out["ok"], out["why"], time.time()
    try:
        STATE_DIR.mkdir(parents=True, exist_ok=True)
        tmp = Path(str(cache) + ".tmp")
        tmp.write_text(json.dumps(rec, indent=1))
        os.chmod(str(tmp), 0o600)
        os.replace(str(tmp), str(cache))
    except OSError:
        pass                                 # a verdict that cannot be cached is a verdict
    return out


# ---------------------------------------------------------------------------- sessions

@dataclass
class Session:
    account: Account
    local_id: str
    transcript: Path
    mtime: float
    cwd: str = ""
    title: str = ""
    bridge_id: str = ""          # the cse_/session_ suffix, prefix stripped
    perm: str = ""
    model: str = ""
    pid: int = 0
    proc_start: str = ""         # the registry's `procStart`: the pid's identity, not a date
    tmux: str = ""
    status: str = ""
    entrypoint: str = ""
    rc_name: str = ""
    quota: dict = field(default_factory=dict)
    ended_remotely: bool = False
    mcp_servers: list = field(default_factory=list)
    #: The servers a tool was actually CALLED on, a subset of `mcp_servers`
    #: (which is every `mcp__…` name the two read windows carry, call or not).
    mcp_used: list = field(default_factory=list)
    pos: int = 0
    #: Set only by `--from-machine`: the machine the session lives on, its transcript's
    #: path THERE, the desktop app's record of it over there (when it has one), and what
    #: `REMOTE_HELPER detail` saw. `origin` empty means an ordinary one-machine move, and
    #: every cross-machine branch is keyed on it.
    origin: str = ""
    origin_path: str = ""
    desktop: dict = field(default_factory=dict)
    detail: dict = field(default_factory=dict)

    @property
    def short(self) -> str:
        return self.local_id[:8]

    @property
    def handle(self) -> str:
        """What a listing prints for this row's account: its handle, else its name."""
        return self.account.label

    @property
    def live(self) -> bool:
        return bool(self.pid)

    @property
    def url(self) -> str:
        return f"https://claude.ai/code/session_{self.bridge_id}" if self.bridge_id else ""

    @property
    def sibling(self) -> Path:
        return self.transcript.with_suffix("")

    @property
    def label(self) -> str:
        """What the app shows: the title from the transcript, else the Remote Control name."""
        return self.title or self.rc_name or self.short

    @property
    def is_self(self) -> bool:
        sid, pids = self_session()
        return (bool(sid) and self.local_id.lower() == sid) or (bool(self.pid) and self.pid in pids)

    def row(self) -> dict:
        return {
            "pos": self.pos, "account": self.account.name, "handle": self.handle,
            "email": self.account.email,
            "title": self.title, "local_id": self.local_id, "short": self.short,
            "cwd": self.cwd, "transcript": str(self.transcript), "live": self.live,
            "pid": self.pid, "tmux": self.tmux, "status": self.status,
            "entrypoint": self.entrypoint, "permission_mode": self.perm, "model": self.model,
            "bridge_id": self.bridge_id, "url": self.url,
            "last_activity": time.strftime("%Y-%m-%dT%H:%M:%S", time.localtime(self.mtime)),
            "age": human_age(self.mtime), "out_of_quota": bool(self.quota),
            "quota": self.quota or None, "is_self": self.is_self,
            "ended_remotely": self.ended_remotely, "mcp_servers": self.mcp_servers,
        }


def _iter_json_lines(blob: bytes, drop_first: bool = False):
    lines = blob.split(b"\n")
    if drop_first and lines:
        lines = lines[1:]                    # a tail starts mid-line
    for ln in lines:
        ln = ln.strip()
        if not ln.startswith(b"{"):
            continue
        try:
            d = json.loads(ln)
        except ValueError:
            continue                         # a head ends mid-line
        if isinstance(d, dict):
            yield d


def _mcp_called(d: dict) -> set:
    """The MCP servers this one transcript line CALLED a tool on — never merely named.

    A call is a `tool_use` content block whose own `name` is `mcp__<server>__<tool>`. The
    block has to carry both, on the same object, which is what tells a call apart from a
    tool DEFINITION that happens to be in the same line (a deferred-tool metadata block, a
    tool-search result): those carry the name without the `tool_use` type.
    """
    m = d.get("message")
    out = set()
    for block in (m.get("content") if isinstance(m, dict) else None) or ():
        if not isinstance(block, dict) or block.get("type") != "tool_use":
            continue
        name = block.get("name")
        if not isinstance(name, str):
            continue
        parts = name.split("__")
        if len(parts) >= 3 and parts[0] == "mcp" and parts[1]:
            out.add(parts[1])
    return out


def _text_of(message) -> str:
    if not isinstance(message, dict):
        return ""
    c = message.get("content")
    if isinstance(c, str):
        return c
    out = []
    if isinstance(c, list):
        for part in c:
            if isinstance(part, dict) and part.get("type") == "text":
                out.append(str(part.get("text") or ""))
    return "\n".join(out)


def _status_bridge(d: dict) -> str:
    """The bridge id a `/remote-control is active` line carries in its url, or `""`.

    Measured on CLI 2.1.312, Wed 28 Oct 2026: a `--remote-control=` session writes
    `{"type": "system", "subtype": "bridge_status", "url":
    "https://claude.ai/code/session_X", "content": "/remote-control is active · Continue
    here, on your phone, or at https…", …}`. It is the third place a local transcript ever
    names its claude.ai session, after the `bridge-session` line and the live registry row.
    """
    if d.get("type") != "system" or d.get("subtype") != "bridge_status":
        return ""
    u = d.get("url")
    return bare_bridge_id(u) if isinstance(u, str) else ""


_TITLE_KINDS = (("custom-title", "customTitle"), ("ai-title", "aiTitle"),
                ("last-prompt", "lastPrompt"))


def scan_transcript(path: Path) -> dict:
    """Title, cwd, claude.ai id, permission mode, model and the quota verdict, in two seeks.

    The quota verdict is a heuristic, and says so: a transcript records every limit it ever
    hit, including ones that were waited out. A session is flagged only when its last
    limit is still in force (`resetsAt` in the future) or is the last assistant line in
    the file, i.e. the session stopped there and is waiting.
    """
    info = {"title": "", "cwd": "", "bridge_id": "", "perm": "", "model": "", "quota": {},
            "sidechain_only": True, "ended_remotely": False, "mcp_servers": [],
            "mcp_used": []}
    try:
        size = path.stat().st_size
        with path.open("rb") as f:
            head = f.read(min(size, HEAD_BYTES))
            if size > HEAD_BYTES + TAIL_BYTES:
                f.seek(size - TAIL_BYTES)
                tail, drop = f.read(TAIL_BYTES), True
            else:
                tail, drop = (head + f.read()) if size > HEAD_BYTES else head, False
    except OSError:
        return info

    titles = {k: "" for k, _ in _TITLE_KINDS}
    used = set()
    first_prompt = head_perm = head_bridge = url_bridge = ""
    for d in _iter_json_lines(head):
        used |= _mcp_called(d)
        if not d.get("isSidechain", False):
            info["sidechain_only"] = False
        if not info["cwd"] and isinstance(d.get("cwd"), str):
            info["cwd"] = d["cwd"]
        if not head_perm and isinstance(d.get("permissionMode"), str):
            head_perm = d["permissionMode"]
        t = d.get("type")
        for kind, key in _TITLE_KINDS:
            if t == kind and isinstance(d.get(key), str):
                titles[kind] = d[key]
        if t == "bridge-session" and isinstance(d.get("bridgeSessionId"), str):
            head_bridge = d["bridgeSessionId"]
        url_bridge = _status_bridge(d) or url_bridge
        if not first_prompt and t == "user" and not d.get("isSidechain"):
            txt = _text_of(d.get("message"))
            if txt and not txt.lstrip().startswith("<"):
                first_prompt = txt

    perm = bridge = ""
    quota = {}
    quota_idx = assistant_idx = -1
    for i, d in enumerate(_iter_json_lines(tail, drop_first=drop)):
        used |= _mcp_called(d)
        t = d.get("type")
        for kind, key in _TITLE_KINDS:
            if t == kind and isinstance(d.get(key), str):
                titles[kind] = d[key]            # the tail comes later in the file: it wins
        if t == "bridge-session" and isinstance(d.get("bridgeSessionId"), str):
            bridge = d["bridgeSessionId"]
        url_bridge = _status_bridge(d) or url_bridge
        if t == "permission-mode" and isinstance(d.get("permissionMode"), str):
            perm = d["permissionMode"]
        # 🛑 The desktop app writes no `permission-mode` line: it puts the mode on every
        # prompt line instead. In file order, the later of the two kinds wins.
        if t == "user" and not d.get("isSidechain") and isinstance(d.get("permissionMode"), str):
            perm = d["permissionMode"]
        if not info["cwd"] and isinstance(d.get("cwd"), str):
            info["cwd"] = d["cwd"]
        m = d.get("message")
        # A session ended or archived from the app says so on a `system` line. Resuming
        # such a session is rarely what anyone wants, so the row says "closed", not "ended".
        if t == "system" and ENDED_REMOTELY in (_text_of(m) or str(d.get("content") or "")):
            info["ended_remotely"] = True
        if t == "assistant" and isinstance(m, dict) and not d.get("isSidechain"):
            err = d.get("apiError") or m.get("apiError")
            # 🛑 TWO SHAPES OF ONE STOP, and the second one used to read as a clean finish.
            # Measured on this machine, CLI 2.1.312, Wed 28 Oct 2026: of 44 assistant
            # quota-stop lines in the config homes here, 34 carry an `apiError` and 10
            # carry NO `apiError` key at all — only `isApiErrorMessage: true`,
            # `error: "rate_limit"`, `apiErrorStatus: 429` and a top-level `quotaLimits`
            # ({status, resetsAt, rateLimitType, …}). Those fell into the clean-line branch
            # below, so `quota` stayed empty AND `assistant_idx` was set, which additionally
            # defeated the in-force heuristic for a real quota line earlier in the tail:
            # csm said such a session had FINISHED. Both keys are required together,
            # because `error` alone is not this line.
            if err in QUOTA_ERRORS or (d.get("isApiErrorMessage")
                                       and d.get("error") == "rate_limit"):
                quota_idx = i
                p = d.get("apiErrorParams") or m.get("apiErrorParams") or {}
                rl = p.get("rate_limit_info") if isinstance(p, dict) else None
                rl = rl if isinstance(rl, dict) else {}
                resets = epoch_s(rl.get("resetsAt"))
                kind = rl.get("rateLimitType") or ""
                if not resets or not kind:
                    # Some builds carry the reset under `quotaLimits` instead, on the line
                    # or inside the message — and the no-`apiError` shape carries the WINDOW
                    # there too (`five_hour` / `seven_day`), which is the word a caller keys
                    # on to say whether waiting clears the stop at all.
                    for holder in (p, d, m):
                        q = holder.get("quotaLimits") if isinstance(holder, dict) else None
                        if not isinstance(q, dict):
                            continue
                        if not resets and epoch_s(q.get("resetsAt")):
                            resets = epoch_s(q.get("resetsAt"))
                        if not kind and isinstance(q.get("rateLimitType"), str):
                            kind = q["rateLimitType"]
                        if resets and kind:
                            break
                quota = {"error": err or str(d.get("error") or ""), "kind": kind,
                         "resets_at": resets, "message": tidy(_text_of(m), 80)}
            elif not err and answered_here(d, m):
                # Only a line that is really the session ANSWERING counts — `answered_here`
                # holds the two exceptions and what each of them cost. `revive_stop` asks
                # the same question, so the two readers cannot disagree about one file.
                assistant_idx = i
                mdl = m.get("model")
                if isinstance(mdl, str) and MODEL_RE.fullmatch(mdl):
                    info["model"] = mdl

    if quota and (quota["resets_at"] > time.time() or quota_idx > assistant_idx):
        info["quota"] = quota
    # 🛑 No mode in the tail: the last prompt is further back than TAIL_BYTES (a long agentic
    # turn writes megabytes of tool results after its prompt). Read backwards for the last
    # recorded mode before settling for the first one; a session that silently resumed in
    # `default` would stop for a click on every tool call.
    if not perm and size > len(tail):
        perm = last_mode(path, size)
    info["perm"] = perm or head_perm
    # 🛑 TWO BUCKETS, BECAUSE A NAME IS NOT A CALL. A server named `claude_ai_<Connector>`
    # is a claude.ai CONNECTOR: it belongs to the account, not to the config home, so a
    # move changes which ones the session can reach — and that is worth saying either way.
    # But `mcp_servers` is a byte scan of the two windows, and a transcript carries
    # `"name": "mcp__…"` in places that are not calls: a deferred-tool metadata block
    # (`surfacedDefinitions`), a tool-search result, a user quoting a tool name. Measured:
    # the plan claimed a connector "has been used" for one that was only listed. So
    # `mcp_used` is the narrow answer — a `tool_use` block whose own `name` is an
    # `mcp__…` tool, read through the parsed line, which a window cut mid-line simply
    # yields nothing for — and `mcp_servers` stays the wide one, reported as a MENTION.
    names = set()
    for blob in (head, tail):
        for mm in MCP_TOOL_RE.finditer(blob):
            names.add(mm.group(1).decode("utf-8", "ignore"))
    info["mcp_servers"] = sorted(n for n in names if n)
    info["mcp_used"] = sorted(n for n in used if n)
    # 🛑 A `bridge-session` line first, a `bridge_status` url second: they name the same
    # session, and the explicit line is the one the CLI writes on purpose. The url is read
    # because the two sit in DIFFERENT PLACES in the file — `bridge-session` is written once
    # near the start and falls into the unread middle of a long transcript, while
    # `bridge_status` is rewritten every time `/remote-control` reports in and is therefore
    # in the tail. Measured on CLI 2.1.312, Wed 28 Oct 2026: 97 of the 1,935 transcripts in
    # the config homes here carry such a line, every one of them beside a `bridge-session`
    # line — so today it is a second source for the same id, not the only source for any.
    info["bridge_id"] = re.sub(r"^(cse_|session_)", "",
                               bridge or head_bridge or url_bridge)
    info["title"] = tidy(titles["custom-title"] or titles["ai-title"]
                         or titles["last-prompt"] or first_prompt)
    return info


def last_mode(path: Path, end: int, chunk: int = 1 << 20) -> str:
    """The last `permissionMode` recorded before byte `end`, reading backwards."""
    pos, carry = end, b""
    try:
        with path.open("rb") as f:
            while pos > 0:
                start = max(0, pos - chunk)
                f.seek(start)
                buf = f.read(pos - start) + carry
                found = PERM_RE.findall(buf)
                if found:
                    return found[-1].decode()
                carry = buf[:64]                 # a match split across the boundary
                pos = start
    except OSError:
        return ""
    return ""


def pid_alive(pid: int) -> bool:
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    except OSError:
        return False
    return True


def live_rows(acct: Account, problems: list = None) -> dict:
    """`{local id: registry row}` for this home's RUNNING sessions.

    `<home>/sessions/<pid>.json` is the registry the CLI keeps, one file per process. It is
    the only map from a phone session to its transcript: a session spawned by a Remote
    Control server runs with a claude.ai id in its argv while its transcript is named by a
    different local id. Dead processes leave their files behind, so a row counts only while
    its pid answers.

    `problems` is the coverage channel `modes` needs. A registry directory that would not
    open, or a file that would not parse while its pid is alive, is otherwise swallowed and
    read downstream exactly like "this home runs nothing" — the one answer that is never
    true. When a list is passed it is appended `{name, age_s, reason}`; `None` (every
    caller that only wants the rows) keeps the quiet behaviour.
    """
    out = {}
    d = acct.home / "sessions"
    try:
        # 🛑 `os.listdir`, NOT `d.glob("*.json")`. pathlib's glob swallows the
        # PermissionError `scandir` raises on a directory it may not read and yields
        # nothing, so a home this process is locked out of came back empty and read
        # downstream exactly like "this home runs nothing" — a locked-out home passing as
        # ok is the one answer a sweep may never give. `listdir` raises, so the caller is
        # told. The leading-dot filter keeps the set of names glob would have matched.
        files = sorted(d / n for n in os.listdir(str(d))
                       if n.endswith(".json") and not n.startswith("."))
    except FileNotFoundError:
        # 🛑 NOT a coverage problem, and the distinction is the whole value of this channel.
        # The CLI creates `sessions/` the first time a session runs in a home, so its
        # ABSENCE is a measurement: nothing has ever run here. Reporting it as unread would
        # make every quiet home on every machine turn `modes --check` into INCOMPLETE —
        # which is what a scheduled caller reads as "the sweep is broken".
        return out
    except OSError as e:
        if problems is not None:
            problems.append({"name": acct.label, "age_s": None,
                             "reason": "%s would not open (%s): nothing says what is "
                                       "running in this home"
                                       % (tilde(d), e.__class__.__name__)})
        return out
    for f in files:
        try:
            pid = int(f.stem)
        except ValueError:
            continue
        if not pid_alive(pid):
            continue
        r = read_json(f)
        if not isinstance(r, dict):
            if problems is not None:
                problems.append({"name": "%s:pid %d" % (acct.label, pid),
                                 "age_s": file_age_s(f),
                                 "reason": "its registry file %s could not be read as "
                                           "JSON, and pid %d is alive — so a live session "
                                           "is unaccounted for" % (f.name, pid)})
            continue
        sid = r.get("sessionId")
        if isinstance(sid, str) and sid:
            r["pid"] = pid
            out[sid] = r
    return out


def transcripts_by_id(acct: Account, only=None) -> dict:
    """`{local id: (mtime, path)}` for this home's transcripts, NEWEST COPY PER ID.

    🛑 One row per session id, and the greatest mtime wins. One id really does sit in
    several project folders of ONE home — a folder reached through a symlink and the folder
    itself are two slugs — so picking whichever copy `glob` yielded last (arbitrary dirent
    order) would point a listing row, and therefore `csm move <id>`, at a stale snapshot of
    the same conversation. The copy the CLI has been writing is the newest one.

    `only` is a set of 8-character id prefixes, narrowing WHICH ids are read and nothing
    else, so a row from a narrowed call is identical to one from a full scan.

    🛑 CSM'S OWN RELAY TRANSCRIPTS ARE NOT SESSIONS. Every `revive` runs a `claude -p` relay
    in `relay_dir()`, and the CLI files that run's own transcript under the project folder of
    its cwd — inside the revived session's home (see `relay_dir`). Left in, each revive added
    a row to `csm list`, to `csm find` and to revive's own resolution whose title was the
    relay instruction, and `csm revive` would happily have revived one. One folder name is
    skipped, by the slug alone: no file in it is opened, and a transcript a person really put
    there is not something this tool goes near either.
    """
    skip = relay_slug()
    try:
        cands = [(p.stat().st_mtime, p) for p in acct.projects.glob("*/*.jsonl")
                 if p.parent.name != skip and p.is_file()]
    except OSError:
        cands = []
    by_id = {}
    for m, p in cands:
        if only is not None and p.stem[:8] not in only:
            continue
        cur = by_id.get(p.stem)
        if cur is None or m > cur[0]:
            by_id[p.stem] = (m, p)
    return by_id


def sessions_for(acct: Account, limit: int, only=None, pin: str = "") -> list:
    """This account's `limit` most recently touched sessions, plus every live one.

    `only` is a set of 8-character id prefixes: a caller that already knows which handful
    of sessions it can possibly mean (`csm stop`, from the windows csm opened) skips
    reading every other transcript in the home. It narrows WHICH rows are built, never
    how one is built, so a row from a narrowed call is identical to one from a full scan.

    🛑 `pin` is a WHOLE session id, and it makes the list however old its file is. An id
    typed in full names one file and nothing else, so refusing to look at it because the
    newest few hundred transcripts are more recent is refusing to answer the question that
    was asked — and on a busy machine those few hundred can be a fortnight, while the
    session somebody names by its id is typically one that has been idle.
    """
    live = live_rows(acct)
    by_id = transcripts_by_id(acct, only)
    chosen = [by_id[s] for s in live if s in by_id]
    pinned = 1 if pin and pin in by_id and pin not in live else 0
    if pinned:
        chosen.append(by_id[pin])
    for m, p in sorted(by_id.values(), key=lambda t: -t[0]):
        if len(chosen) >= limit + len(live) + pinned:
            break
        if p.stem not in live and not (pinned and p.stem == pin):
            chosen.append((m, p))
    out = []
    for m, p in chosen:
        row = session_of(acct, p, m, live.get(p.stem))
        if row is not None:
            out.append(row)
    return out


def session_of(acct: Account, path: Path, mtime: float, live_row: dict = None,
               subagent_rule: bool = True):
    """ONE ROW, from one transcript and its registry row (if it has one) — or `None`.

    `None` is the SUBAGENT RULE: a transcript whose every line is a sidechain is a
    subagent's own file and is not a session anybody means, so `list`, `move` and `stop`
    never see one. `subagent_rule=False` turns that off, for the one caller that has to
    answer ABOUT such a file rather than skip it (`revive`: "there is nothing to continue"
    is an answer about a 0-byte pre-created session, and "no transcript for that link here"
    would be false about a file that is on disk).
    """
    info = scan_transcript(path)
    if subagent_rule and info["sidechain_only"]:
        return None
    r = live_row or {}
    return Session(
        account=acct, local_id=path.stem, transcript=path, mtime=mtime,
        cwd=info["cwd"] or str(r.get("cwd") or ""), title=info["title"],
        bridge_id=info["bridge_id"]
        or re.sub(r"^(cse_|session_)", "", str(r.get("bridgeSessionId") or "")),
        perm=info["perm"], model=info["model"], pid=int(r.get("pid") or 0),
        proc_start=str(r.get("procStart") or ""),
        tmux=str(r.get("tmux") or ""), status=str(r.get("status") or ""),
        entrypoint=str(r.get("entrypoint") or ""), rc_name=str(r.get("name") or ""),
        quota=info["quota"], ended_remotely=info["ended_remotely"],
        mcp_servers=info["mcp_servers"],
        mcp_used=info["mcp_used"])


#: One entry per transcript the last `dedupe_shared` collapsed: how many EXTRA homes saw it.
#: A one-value cache in the same shape as `_SELF`; the listing prints a line from it.
SHARED: list = []
#: How many rows the last `all_sessions` cap left out, in the same one-value shape. The
#: listing prints a line from it, because `csm move <#>` is numbered against THAT table.
CUT: list = []


def _owns_side_data(acct: Account, sid: str) -> bool:
    """Does this home hold the session's per-home side data (`tasks/<id>/`, `todos/<id>*`)?"""
    try:
        if (acct.home / "tasks" / sid).is_dir():
            return True
        return any((acct.home / "todos").glob(sid + "*.json"))
    except OSError:
        return False


def dedupe_shared(rows: list) -> list:
    """ONE ROW PER FILE: collapse rows that are the same transcript seen from several homes.

    🛑 When two or more homes' `projects/` resolve to one directory, `sessions_for` returns
    the same transcript once per home. Without this, `csm list` shows each session N times
    (and a `--limit` spends its rows on one conversation), and `csm move <id>` refuses every
    session that is not running, because several hits read as several copies.
    Collapsed by the transcript's REALPATH, never by the id alone: after an ordinary move
    between unshared homes there are two genuine copies of one id, and those stay two rows.
    The row kept names the account whose `sessions/<pid>.json` says it is RUNNING the
    session (the only on-disk fact about who owns a shared transcript), else the one holding
    its per-home `tasks/`/`todos/`, else the first home in account order.
    """
    groups, order = {}, []
    for s in rows:
        try:
            key = os.path.realpath(str(s.transcript))
        except OSError:
            key = str(s.transcript)
        if key not in groups:
            groups[key] = []
            order.append(key)
        groups[key].append(s)
    out = []
    del SHARED[:]
    for key in order:
        g = groups[key]
        if len(g) == 1:
            out.append(g[0])
            continue
        best = (next((x for x in g if x.live), None)
                or next((x for x in g if _owns_side_data(x.account, x.local_id)), None)
                or g[0])
        SHARED.append(len(g) - 1)
        out.append(best)
    return out


def all_sessions(accts: list, limit: int, only=None, hard: bool = False,
                 pin: str = "") -> list:
    """Newest first across every account.

    Two caps, and which one applies is the whole of `--limit`'s meaning:

      * NOTHING WAS ASKED FOR (`hard=False`): `limit` caps the ended rows, and a LIVE
        session is never cut. That is right when the number is this tool's own default —
        "move my running session" is the ask, and that session may be the oldest file here.
      * A NUMBER WAS TYPED (`hard=True`): at most `limit` rows, the newest, live or not. On
        a machine where every Remote Control worker registers as live, the exemption above
        swallows the whole list, so `--limit 5` printed 45 rows and the flag was advertised
        and inert. `CUT` then carries how many rows were left out, because the number the
        next command takes — `csm move <#>` — is numbered against the table that prints.

    A `pin` (a whole session id) survives the DEFAULT cap, beside the live rows: a caller
    that named one file by its full id is asking about that file, and dropping it for
    being old would answer a different question. An explicit `--limit` still outranks it.
    See `sessions_for`.
    """
    out = []
    for a in accts:
        if a.home.is_dir():
            out.extend(sessions_for(a, limit, only, pin))
    # BEFORE the cap: N rows that are one file must not spend N of its rows.
    out = dedupe_shared(out)
    out.sort(key=lambda s: -s.mtime)
    def wanted(x):
        return x.live or (pin and x.local_id == pin)

    if hard:
        # ⚠️ A hard cap outranks a pin, exactly as it outranks a live row: `--limit N`
        # means at most N rows and nothing is worth making it mean something else. The two
        # never meet today — `list` takes the cap and never a pin, `move` the reverse — and
        # if they ever do, the number that was typed is the one that was typed.
        keep = out[:max(0, limit)]
    else:
        keep = [s for s in out if wanted(s)]
        for s in out:
            if len(keep) >= limit:
                break
            if not wanted(s):
                keep.append(s)
    del CUT[:]
    CUT.append(len(out) - len(keep))
    keep.sort(key=lambda s: -s.mtime)
    for i, s in enumerate(keep, 1):
        s.pos = i
    return keep


# ------------------------------------------------------------------------- list output

def save_picks(rows: list) -> None:
    try:
        PICKS.parent.mkdir(parents=True, exist_ok=True)
        PICKS.write_text(json.dumps({"at": time.time(), "rows": [
            {"pos": s.pos, "account": s.account.name, "local_id": s.local_id} for s in rows]},
            indent=1))
    except OSError:
        pass


def load_picks() -> list:
    d = read_json(PICKS)
    return (d.get("rows") or []) if isinstance(d, dict) else []


def render_list(rows: list, accts: list) -> str:
    if not rows:
        return "no Claude Code sessions found in any account home (see `csm accounts`)"
    w = min(max(max(len(s.label) for s in rows), 18), ROW_TITLE)
    # The account cell is the HANDLE when the accounts file gives one, so the column is the
    # width of a handle on a phone instead of sixteen — and a handle is what gets typed back
    # at `--to`. The floor is the HEADER's own width: narrower than that and the header's
    # `title`, `age` and `state` sit one column right of every row under them, which reads
    # as a broken table and hides which column a value is in.
    aw = min(max(max(len(s.handle) for s in rows), len("account")), 16)
    out = [f"{'#':>3}  {'account':<{aw}} {'title':<{w}} {'age':>4}  state"]
    for s in rows:
        bits = [f"{s.short} {Path(s.cwd).name or '?'}"]
        if s.is_self:
            bits.append("← this session")
        if s.quota:
            k = {"five_hour": "5h", "seven_day": "week"}.get(s.quota.get("kind"), "quota")
            bits.append(f"⚠ OUT OF QUOTA ({k}, resets {clock(s.quota.get('resets_at') or 0)})")
        state = "● live" if s.live else ("  closed" if s.ended_remotely else "  ended")
        out.append(f"{s.pos:>3}  {tidy(s.handle, aw):<{aw}} {tidy(s.label, w):<{w}} "
                   f"{human_age(s.mtime):>4}  {state:<8} {'  '.join(bits)}")
    out.append("")
    # 🛑 A CAPPED TABLE SAYS SO. One that stops at row 5 with no word reads as "these are
    # all your sessions", and `csm move <#>` is numbered against this table.
    # ⚠️ "at least": a capped read collects `limit + the live rows` PER ACCOUNT, not every
    # transcript on the machine, so the second number is a floor and never a total. `--all`
    # is the one that reads everything.
    cut = CUT[0] if CUT else 0
    if cut > 0:
        out.append(f"(the newest {len(rows)} of at least {len(rows) + cut} on this machine "
                   f"— `csm list --all` for every one)")
    if SHARED:
        n = len(SHARED)
        out.append(("(%d of these rows %s one transcript that several account homes can see "
                    "— their projects/ is one shared tree — so `account` names the home "
                    "running it, not the only one that reaches it)")
                   % (n, "is" if n == 1 else "are each"))
    out.append("move one with:  csm move <#> --to <account>      (accounts: "
               + ", ".join(a.label for a in accts) + ")")
    return "\n".join(out)


# --------------------------------------------------------------------- picking a session

def one_of(hits: list, what: str, soft: bool = False):
    """One row out of several matches, or a refusal naming every one.

    🛑 A MOVE IS A COPY, so after the first move the same id sits in two account homes, with
    the same title. The LIVE copy is the one you mean; two live copies, or none, is refused
    with the row numbers to choose from. Taking the first match would move a stale snapshot,
    and with --stop-source stop a session nobody named.

    `soft=True` returns None wherever this would refuse, changing nothing about what is
    matched: a caller can then try a NARROWED list first (the copy `csm stop` has a window
    for, say) and still produce the full refusal from the complete list afterwards.
    """
    if len(hits) == 1:
        return hits[0]
    live = [h for h in hits if h.live]
    if len(live) == 1:
        return live[0]
    if soft:
        return None
    die(f"{what} matches {len(hits)} sessions (a move is a copy, so one id can sit in more "
        "than one account): "
        # `handle`, because this list is read beside `csm list`'s table and typed back at
        # `--to`: naming the accounts here by their table key while the table names them
        # by handle reads as two different sets of accounts.
        + "; ".join(f"{h.pos}. {h.handle} {h.short} {'live' if h.live else 'ended'} "
                    f"({h.label})" for h in hits)
        + ". Say which, by its row number from `csm list`")
    raise AssertionError("unreachable")


def pick(spec: str, rows: list, soft: bool = False):
    """THE LADDER, first unique win; more than one match is listed, never guessed.

      1. a row number from the last `csm list` on this machine
      2. an exact local session id
      3. a unique prefix of one (4 characters or more)
      4. a claude.ai/code/session_... link, or a bare cse_.../session_... id
      5. a unique, case-insensitive piece of the title

    `soft=True` returns None instead of refusing, so a caller can run the same ladder over
    a preferred subset first. Only the hard path ever produces user-facing refusal text, so
    the two cannot drift apart.
    """
    s = (spec or "").strip()
    if not s:
        if soft:
            return None
        die("name a session: a row number from `csm list`, a session id, a claude.ai link, "
            "or part of its title")
    if s.isdigit():
        picks = load_picks()
        hit = [p for p in picks if int(p.get("pos") or 0) == int(s)]
        if not hit:
            if soft:
                return None
            die(f"row {s} is not in the last `csm list` "
                f"({'no list has been run' if not picks else f'it had {len(picks)} rows'}): "
                "run `csm list` and use a number it prints")
        want = hit[0]
        for r in rows:
            if r.local_id == want.get("local_id") and r.account.name == want.get("account"):
                return r
        if soft:
            return None
        die(f"row {s} was session {str(want.get('local_id'))[:8]} in {want.get('account')}, "
            "which is no longer there: run `csm list` again")
    low = s.lower()
    exact = [r for r in rows if r.local_id.lower() == low]
    if exact:
        return one_of(exact, f"session id {s}", soft)
    if len(s) >= 4:
        hits = [r for r in rows if r.local_id.lower().startswith(low)]
        if hits:
            return one_of(hits, f"'{s}' as the start of a session id", soft)
    m = URL_RE.search(s)
    if m:
        hits = [r for r in rows if r.bridge_id == m.group(1)]
        if hits:
            return one_of(hits, f"claude.ai id {m.group(1)}", soft)
        if soft:
            return None
        die(f"no session here has the claude.ai id '{m.group(1)}'. It may live on another "
            "machine (`csm --machine M list`), or be older than this listing (`--all`)")
    hits = [r for r in rows if low in (r.label or "").lower()]
    if hits:
        return one_of(hits, f"'{s}'", soft)
    if soft:
        return None
    die(f"'{s}' matches no session in this listing. `csm list --all` widens it")
    raise AssertionError("unreachable")


# ----------------------------------------------------------------------- the spec layer

@dataclass
class Spec:
    """What a typed session spec resolves to BEFORE any listing is built.

    `pick` is a ladder over a LISTING; this is about the spec itself, and it runs first for
    one reason: a claude.ai link, a bridge id or a spacesheep session link names its
    transcript by arithmetic (`derive_local_id`), so a session with no registry row — a
    DEAD one, which is the case a link lookup exists for — still resolves.
    """
    #: What was typed, trimmed. The only thing handed to `pick` when this is not a link.
    typed: str = ""
    #: The spec is a link / bridge id / spacesheep session link. It changes what a MISS
    #: means: a link is an exact question and gets an exact answer or a refusal.
    link: bool = False
    #: The bare claude.ai id, when the spec carried one (empty for a spacesheep link).
    bare: str = ""
    #: The local transcript id the spec names, computed.
    derived: str = ""
    #: A WHOLE local id to pin into the listing past its age cap: the typed id, or a
    #: derived one whose transcript is really in a home here.
    pin: str = ""
    #: Account labels whose `projects/` holds `<derived>.jsonl`, and all the labels looked
    #: in — the second is what a refusal has to name, so the reader knows what was asked.
    homes: list = field(default_factory=list)
    searched: list = field(default_factory=list)
    #: 🛑 The folders that would not OPEN while looking for the derived transcript. They are
    #: the difference between "no home here holds it" and "this is what could not be read",
    #: and every sentence that would otherwise claim absence names them instead.
    unread: list = field(default_factory=list)
    canary: dict = field(default_factory=dict)

    @property
    def what(self) -> str:
        """What to CALL the thing that was typed, in a sentence."""
        if self.bare:
            return "session_" + self.bare
        return "that spacesheep session page" if self.link else self.typed


def home_copies(acct: Account, name: str, unread: list = None) -> list:
    """Every `projects/*/<name>` this home really holds. Unreadable folders go in `unread`.

    🛑 `os.listdir` AND A STAT PER FOLDER, NOT `glob`. `Path.glob` swallows the
    PermissionError its own scan raises and yields nothing, so a project folder — or a whole
    `projects/` tree — this process may not read came back as "this home does not hold it",
    and the two callers then said so out loud: `resolve_spec` dropped the home from
    `Spec.homes`, and `pick_resolved` and `cmd_find` printed "nothing under <homes> holds it"
    about a directory they had never been allowed to open. For `revive` that is the worst
    answer the feature can give — the person is told the session they are rescuing is not on
    this machine. `preflight` measured the same thing on 3.7.9 and 3.13 and was rewritten for
    it; this is the spec layer's copy of that rule. "Could not look" is never a verdict, so a
    folder that would not open is recorded rather than dropped.
    """
    out = []
    try:
        folders = sorted(os.listdir(str(acct.projects)))
    except FileNotFoundError:
        return out                   # nothing has ever run in this home: a measurement
    except OSError as e:
        if unread is not None:
            unread.append("%s (%s)" % (tilde(acct.projects), e.__class__.__name__))
        return out
    skip = relay_slug()
    for n in folders:
        if n == skip:
            continue                   # csm's own relay litter, never a session
        p = acct.projects / n / name
        try:
            # `lstat_kind`, not `is_file`: from 3.14 `is_file` answers False on a
            # permission error too. ENOTDIR reads as not there, which is right.
            mode = lstat_kind(p)
        except OSError as e:
            if unread is not None:
                unread.append("%s (%s)" % (tilde(p.parent), e.__class__.__name__))
            continue
        if mode is not None and statmod.S_ISREG(mode):
            out.append(p)
    return out


def resolve_spec(spec: str, accts: list) -> Spec:
    """Derive what a typed spec names, and say which home holds it. Reads no transcript.

    🛑 THE SPEC LAYER, ABOVE `pick`. Three things happen here and nowhere else:
      * a WHOLE local id is pinned, exactly as before (`FULL_ID_RE`);
      * a LINK is derived, and when that transcript really is in a home here the full id is
        pinned too — which is what carries it past the listing's age cap and past the
        absence of a registry row. A link used to resolve only through a live row or a
        transcript's own `bridge-session` line, so every dead server child was unreachable;
      * the spec is MARKED as a link, which is what stops `pick_resolved` from ever handing
        it to the id-prefix or title rungs.
    """
    typed = (spec or "").strip()
    out = Spec(typed=typed)
    low = typed.lower()
    if FULL_ID_RE.match(low):
        out.pin = low
        return out
    derived = derive_local_id(typed)
    if not derived:
        return out
    out.link, out.bare, out.derived = True, bare_bridge_id(typed), derived
    for a in accts:
        out.searched.append(a.label)
        # Every project folder, not one guessed from the cwd: one id can sit in several
        # folders of one home (a folder reached through a symlink is a second slug). And
        # `home_copies`, not `glob` — see its 🛑: a home that could not be read must not
        # come back as a home that does not hold it.
        if home_copies(a, derived + ".jsonl", out.unread):
            out.homes.append(a.label)
    if out.homes:
        out.pin = derived
    out.canary = canary()
    return out


def spec_notes(sp: Spec) -> list:
    """What a plan says about how the spec was resolved: facts, never a guess."""
    out = []
    if not sp.link:
        return out
    if sp.pin:
        out.append("resolved from the link: %s is the transcript %s names, in %s "
                   "(computed from the link, not looked up — nothing has to be running)"
                   % (sp.derived[:8], sp.what, ", ".join(sp.homes)))
    if sp.unread:
        out.append("⚠ not every home could be read while looking for %s: %s — so "
                   "\"nowhere here holds it\" is not a thing this run can say"
                   % (sp.derived[:8] or sp.what, "; ".join(sp.unread[:3])))
    c = sp.canary or {}
    if sp.bare and c.get("ok") is not True:
        # 🛑 NEVER A SILENT PASS. The derivation is still used — it is the only way to this
        # file — but a reader who is about to act on it is told that the constant behind it
        # was not found in the CLI this machine runs.
        out.append("⚠ derivation unverified for CLI %s: %s"
                   % (c.get("version") or "?", c.get("why") or "nothing to check against"))
    return out


def pick_resolved(sp: Spec, rows: list, soft: bool = False):
    """`pick`, with a link resolved first and NEVER falling through to a weaker rung.

    🛑 A LINK IS AN EXACT QUESTION. Its three rungs are the three places a local transcript
    is tied to a claude.ai session, and they are all exact:
      1. the DERIVED id names a transcript in this listing (`BRIDGE_NS`);
      2. a row's `bridge_id` is that bare id — which covers the transcript's own
         `bridge-session` line, a `bridge_status` url in it, and a live registry row's
         `bridgeSessionId`, all three of which `scan_transcript`/`sessions_for` fold into
         that one field.
    Nothing else. A link may never reach the id-prefix rung (a mis-derived id is a plausible
    prefix of some other session) or the TITLE rung — and the title rung is the sharp edge,
    because a session whose first prompt QUOTED the link has the link in its title, so
    "find me this link" would have answered with the session that merely talks about it.
    """
    if not sp.link:
        return pick(sp.typed, rows, soft)
    hits = [r for r in rows if r.local_id.lower() == sp.derived]
    if hits:
        return one_of(hits, "%s (transcript %s)" % (sp.what, sp.derived), soft)
    if sp.bare:
        hits = [r for r in rows if r.bridge_id == sp.bare]
        if hits:
            return one_of(hits, "claude.ai id %s" % sp.bare, soft)
    if soft:
        return None
    looked = ", ".join(sp.searched) or "no account home"
    if sp.unread:
        # 🛑 "COULD NOT LOOK" IS NEVER A VERDICT. The derived name is exact, so a miss would
        # normally be proof of absence — but a `projects/` folder that would not open yields
        # nothing and looks exactly like a folder that does not hold the file, and saying
        # "it is not on this machine" about the session somebody is trying to rescue is the
        # worst answer this command has. So the folders are named and nothing is claimed.
        die("could not finish looking for that link here: %s names %s, and %s would not "
            "open — so whether a home here holds it is UNREAD, not no. Fix those "
            "permissions and run this again, or look with `csm find %s`%s"
            % (sp.what, sp.derived, "; ".join(sp.unread[:3]), shlex.quote(sp.typed),
               "".join("; " + n for n in spec_notes(sp) if not n.startswith("⚠ not"))))
    die("no transcript for that link here: %s names %s, and nothing under %s on %s holds "
        "it. It may be on another machine (`csm find %s --on M`), or belong to a session "
        "this machine never ran. A link is never matched by part of an id or by title — "
        "that would answer with somebody else's session%s"
        % (sp.what, sp.derived, looked, machine(), shlex.quote(sp.typed),
           "".join("; " + n for n in spec_notes(sp))))
    raise AssertionError("unreachable")


# --------------------------------------------------------------------- permission mode

def canon_mode(m: str) -> str:
    m = (m or "").strip()
    return MODE_ALIASES.get(m, m)


def mode_rank(m: str) -> int:
    """Position in MODE_ORDER, or −1 for a mode this tool has never heard of.

    🛑 −1 is NOT "weakest". A CLI that gains a mode must not be silently downgraded by a
    tool one release behind, so an unknown recorded mode is carried through untouched.
    """
    m = canon_mode(m)
    return MODE_ORDER.index(m) if m in MODE_ORDER else -1


def settings_mode(tgt: Account):
    """`(permissions.defaultMode, which file said so)` for the TARGET home, or `("", "")`."""
    for name in ("settings.local.json", "settings.json"):
        d = read_json(tgt.home / name)
        perms = d.get("permissions") if isinstance(d, dict) else None
        v = perms.get("defaultMode") if isinstance(perms, dict) else None
        if isinstance(v, str) and v.strip():
            return canon_mode(v), tilde(tgt.home / name)
    return "", ""


def resolve_mode(s: Session, tgt: Account, asked: str):
    """`(mode, why)` — the permission mode is CHOSEN for the move, not copied.

    🛑 Never weaker than the session was running, and never a mode this tool does not know.
    The order:
      1. `--permission-mode` wins, after validation (`manual` is an alias of `default`);
      2. else, when the TARGET's settings name a `permissions.defaultMode` that is stronger
         AND the transcript recorded nothing, `default` or `auto` — the modes a session
         records by accident — the settings win. A worker spawned by a Remote Control
         server records the mode the claude.ai session record holds, which is `auto` even
         when its server was started in bypassPermissions, and a Remote Control session
         cannot be put back into bypassPermissions from the picker: pass the recorded mode
         through and the move hands back a weaker session than the one that was running;
      3. else the recorded mode, even when the settings are stronger: `plan` and
         `acceptEdits` are deliberate, and a quota move must not hand back a session that
         may now write and run anything unasked;
      4. else the settings' mode, else `default`.
    """
    if asked:
        m = canon_mode(asked)
        if mode_rank(m) < 0:
            die("'%s' is not a permission mode. The modes are: %s (and `manual`, the "
                "settings schema's own alias for `default`)" % (asked, ", ".join(MODE_ORDER)))
        return m, "from --permission-mode"
    rec, (cfg, where) = canon_mode(s.perm), settings_mode(tgt)
    rec_rank = mode_rank(rec) if rec else -1
    if cfg and rec in RAISE_FROM and mode_rank(cfg) > rec_rank:
        return cfg, ("%s says permissions.defaultMode %s, and the session recorded %s, "
                     "which is weaker (a session started by a Remote Control server records "
                     "`auto` even when its server was started in bypassPermissions). %s"
                     % (where, cfg, rec or "no mode",
                        ("`--permission-mode %s` keeps the recorded one" % rec) if rec
                        else "`--permission-mode default` overrides this"))
    if rec:
        if cfg and mode_rank(cfg) > rec_rank >= 0:
            return rec, ("the session was running in %s, which is deliberate, so it is kept "
                         "even though %s says %s. `--permission-mode %s` raises it"
                         % (rec, where, cfg, cfg))
        return rec, "the mode the session was running in"
    if cfg:
        return cfg, "%s says permissions.defaultMode %s; the transcript recorded none" % (
            where, cfg)
    return "default", "nothing recorded the mode and no settings name a default"


#: The CLI's own footer literals, lower-cased, measured on 2.1.300-2.1.301. `default`
#: draws `⏸ manual mode on` — the footer's name for it, not the flag's — so the mode a
#: move asked for and did not get is visible in the pane. There is no footer for
#: `dontAsk`, so a pane showing none of these still says nothing about the mode.
PANE_MODES = (("bypass permissions on", "bypassPermissions"),
              ("accept edits on", "acceptEdits"),
              ("plan mode on", "plan"),
              ("auto mode on", "auto"),
              ("manual mode on", "default"))


def pane_mode(pane: str) -> str:
    """The mode the window's footer shows; the LAST one on the screen wins."""
    low = (pane or "").lower()
    best, at = "", -1
    for lit, mode in PANE_MODES:
        i = low.rfind(lit)
        if i > at:
            best, at = mode, i
    return best


def appended_mode(dest: Path, after: int) -> str:
    """The last `permissionMode` the RESUMED session wrote, reading only past `after`.

    🛑 The copy already contains every mode the source ever recorded, so only the bytes
    appended after the copy ended say what the moved session came up in. The resumed CLI
    writes that line with the FIRST prompt, so right after a move there is usually nothing
    yet: the answer is then `""`, never a guess.
    """
    try:
        size = dest.stat().st_size
        if size <= after:
            return ""
        with dest.open("rb") as f:
            f.seek(after)
            found = PERM_RE.findall(f.read())
    except OSError:
        return ""
    return found[-1].decode() if found else ""


def came_up_as(pane: str, dest: Path, after: int):
    """`(mode, how)` — what the moved session ACTUALLY came up in, or `("", "")`.

    The transcript line outranks the footer: the footer is a render, the line is the CLI's
    own record.
    """
    m = appended_mode(dest, after)
    if m:
        return m, "from the transcript"
    m = pane_mode(pane)
    return (m, "from the window footer") if m else ("", "")



# ------------------------------------------------------------------- the permission sweep
#
# `csm modes` answers one question: is any session RUNNING in a weaker permission mode than
# this machine's `permissions.defaultMode` says it should be? It is the complement of a
# settings check. A settings check reads the FILE and can be right on every machine while a
# live worker sits in `auto`, because a worker a Remote Control server spawns records the
# mode the claude.ai session record holds — not the one its server was started with, and
# leaving a stronger mode is one-way: only a restart or a move puts it back.
#
# It is READ-ONLY except for `--restart-idle --apply`, which is gated (`RESPAWN_VERIFIED`).

#: 🛑 THE GATE on `--restart-idle --apply`, and deliberately not an environment variable: a
#: stray export in a scheduled check's environment must never be able to stop a session.
#: What is measured today is that a stopped Remote-Control worker DOES come back on the
#: next message to that session. What is NOT measured is the MODE it comes back in — one
#: code path keeps the server's own `--permission-mode` and another falls back to
#: `default`, which would turn a sweep meant to raise a mode into one that lowers it.
#: TO VERIFY (then flip this to True, with the date and the numbers): start a throwaway
#: session in a folder whose Remote Control server is running, SIGTERM its worker pid alone
#: leaving the server up, send that session one message from the app, then read
#: `csm modes --json` and `csm list --json` for that session: it must come back, in the
#: server's mode, in the same transcript.
RESPAWN_VERIFIED = False
RESPAWN_WHY = ("the respawn itself is measured, but the MODE a respawned worker comes back "
               "in is not: one code path keeps the server's bypassPermissions and the other "
               "falls back to `default`")

#: The modes a Remote Control worker records BY ACCIDENT — the same set a stronger
#: configured default is allowed to replace on a move (`RAISE_FROM`). Anything else weak is
#: a deliberate choice (shift+tab, or an explicit flag) and is reported as info, never as a
#: fault: this tool judges machines, not people.
WEAK_BY_ACCIDENT = RAISE_FROM

#: The `--permission-mode` a process was STARTED with, off its own `ps` command line.
ARGV_MODE_RE = re.compile(r"--permission-mode[=\s]+([A-Za-z]+)")
#: `claude remote-control …` — the SERVER. 🛑 Never signalled by anything here: stopping one
#: takes every session in that folder with it, and the supervisor starts a new one.
RC_SERVER_RE = re.compile(r"(?:^|/)claude\s+remote-control\b")
#: `claude --resume … --remote-control=<name>` — a session that HOSTS ITS OWN Remote Control
#: link (the windows `csm move` opens are these). Measured: stopping one leaves the session
#: ARCHIVED on claude.ai, because there is no server to bring it back.
RC_REPL_RE = re.compile(r"--remote-control(?:=|\s|$)")


def machine_default_mode(accts: list = None):
    """`(permissions.defaultMode for THIS machine, the file it was read from)`, or `("", "")`.

    The shared home first — one `settings.json` that every account home symlinks to decides
    this for all of them — then any account home that names one of its own, because a home
    whose symlink has been replaced is exactly the drift this should report honestly.
    """
    for home in [SHARED_HOME] + [a.home for a in (accts or [])]:
        st = effective_settings(home)
        perms = st.get("permissions") if isinstance(st, dict) else None
        m = canon_mode((perms or {}).get("defaultMode") or "")
        if m:
            return m, tilde(home / "settings.json")
    return "", ""


def ps_table():
    """`{pid: its whole command line}` in ONE `ps`, or `None` when `ps` COULD NOT BE ASKED.

    One call, not one per session: this sweep reads every live row in every home (dozens on
    a busy machine) and `_ps` spawns a process each time. `None` and `{}` are kept apart for
    the same reason `_ps` keeps them apart — "ps did not answer" is not "that pid is not
    there", and conflating them turns a blinded prover into agreement.
    """
    env = scrubbed_env(dict(os.environ))
    env["LC_ALL"] = "C"                   # one locale, so a parse is a parse everywhere
    env.pop("LANG", None)
    try:
        r = subprocess.run(["ps", "-Ao", "pid=,command="], capture_output=True, text=True,
                           timeout=15, env=env)
    except (OSError, subprocess.SubprocessError):
        return None
    # 🛑 A NON-ZERO EXIT IS "COULD NOT BE ASKED", NOT "NOTHING IS RUNNING" (added Sun 25 Oct
    # 2026). `subprocess.run` without `check` raises for nothing, so a `ps` that rejects
    # this argument spelling — a different `ps` than the one measured here, a container's
    # cut-down one — exits non-zero with an empty stdout, and returning `{}` for that says
    # every pid on the machine is gone. The sweep then reports "pid N is not in `ps`
    # output" about a question it never got to ask, and that reason is quoted in the one
    # `INCOMPLETE:` line a scheduled caller shows. `_ps` keeps the same two apart the same
    # way, and this function's own promise above is the one being kept here.
    if r.returncode != 0:
        return None
    out = {}
    for line in (r.stdout or "").splitlines():
        pid, _, cmd = line.strip().partition(" ")
        if pid.isdigit():
            out[int(pid)] = cmd.strip()
    return out


def launch_mode(cmd) -> str:
    """The `--permission-mode` a process was STARTED with, read off its own command line.

    🛑 A measurement, not a guess, and the only mode a session nobody has messaged yet has:
    a server's pre-created session has a 0-byte transcript, so there is no recorded mode to
    read — while its argv carries the server's own `--permission-mode`.
    """
    m = ARGV_MODE_RE.search(cmd or "")
    return canon_mode(m.group(1)) if m else ""


def live_mode_rows(accts: list):
    """Every LIVE session in these homes with the mode it is really in, and what went unread.

    🛑 A LIVE ROW IS NEVER DROPPED HERE, unlike in `list`. `sessions_for` skips a transcript
    with no main-thread line — the subagent rule — and a server's pre-created session has an
    EMPTY transcript, so such workers are invisible to a listing. A sweep whose whole job is
    "is anything running in the wrong mode?" may not quietly leave out the sessions it could
    not read: they go in `coverage.unread`, each with a reason and an age.
    """
    ps = ps_table()
    self_sid, self_pids = self_session()
    rows = []
    cov = {"read": [], "unread": [], "absent": [], "ps": ps is not None}
    for a in accts:
        if a.machines is not None and not a.machines:
            continue              # the accounts file says this account is on NO machine
        if not a.home.is_dir():
            cov["absent"].append(a.label)
            continue
        problems = []
        live = live_rows(a, problems)
        cov["unread"].extend(problems)
        cov["read"].append(a.label)
        by_id = transcripts_by_id(a)
        for sid, r in sorted(live.items(), key=lambda kv: kv[1].get("pid") or 0):
            pid = int(r.get("pid") or 0)
            cmd = ps.get(pid) if ps is not None else None
            hit = by_id.get(sid)
            if hit:
                mtime, path = hit
                info = scan_transcript(path)
            else:
                mtime, path = 0.0, None
                info = {"perm": "", "title": "", "cwd": "", "bridge_id": ""}
            recorded = canon_mode(info.get("perm") or "")
            launched = launch_mode(cmd)
            if recorded:
                mode, src = recorded, "its transcript"
            elif launched:
                mode, src = launched, "its own command line"
            else:
                mode, src = "", ""
            reg = a.home / "sessions" / ("%d.json" % pid)
            if not mode:
                # Two halves, because the two readings fail for different reasons and a
                # reader fixes different things depending on which one is missing.
                if path is None:
                    first = "it has no transcript in this home"
                elif file_size(path) == 0:
                    first = ("its transcript is 0 bytes — a server's pre-created session "
                             "that nothing has messaged yet")
                else:
                    # Including a file that could not be stat'd at all (`None`): a
                    # transcript that vanished mid-sweep is not an empty one, and this
                    # line may never raise — see `file_size`.
                    first = "its transcript records no permission mode"
                if ps is None:
                    second = "`ps` could not be asked what it was launched with"
                elif cmd is None:
                    second = "pid %d is not in `ps` output" % pid
                else:
                    second = "its command line names no --permission-mode"
                cov["unread"].append({"name": "%s:pid %d" % (a.label, pid),
                                      "age_s": file_age_s(reg),
                                      "reason": "%s, and %s" % (first, second)})
            rows.append({
                "handle": a.label, "account": a.name, "email": a.email,
                "home": str(a.home),
                "local_id": sid, "short": sid[:8], "pid": pid,
                "status": str(r.get("status") or ""),
                "entrypoint": str(r.get("entrypoint") or ""),
                "tmux": str(r.get("tmux") or ""),
                "proc_start": str(r.get("procStart") or ""),
                "title": info.get("title") or str(r.get("name") or "") or sid[:8],
                "cwd": info.get("cwd") or str(r.get("cwd") or ""),
                "bridge_id": info.get("bridge_id")
                or re.sub(r"^(cse_|session_)", "", str(r.get("bridgeSessionId") or "")),
                "transcript": str(path) if path else "",
                "mtime": mtime, "age": human_age(mtime) if mtime else "?",
                "last_activity": (time.strftime("%Y-%m-%dT%H:%M:%S", time.localtime(mtime))
                                  if mtime else ""),
                "mode": mode, "mode_recorded": recorded, "mode_launched": launched,
                "mode_source": src,
                "is_server": bool(cmd and RC_SERVER_RE.search(cmd)),
                "hosts_itself": bool(cmd and not RC_SERVER_RE.search(cmd)
                                     and RC_REPL_RE.search(cmd)),
                "is_self": (bool(self_sid) and sid.lower() == self_sid)
                or (bool(pid) and pid in self_pids),
            })
    return rows, cov


def judge_mode(row: dict, default_mode: str):
    """`(verdict, why)` for one live row: `fault` · `info` · `ok` · `unknown`.

    A FAULT is one thing only: a Remote Control WORKER (`entrypoint: sdk-cli`) running one
    of the modes such a worker records BY ACCIDENT — nothing, `default` or `auto` — while
    this machine's `permissions.defaultMode` is stronger. `plan` and `acceptEdits` are
    deliberate, and the mode of a session started in a TERMINAL is its owner's own business:
    both are info. An unknown mode, and a mode nothing could measure, are `unknown` — never
    `ok`, because unknown is not a pass.
    """
    mode = row["mode"]
    if not default_mode:
        return "unknown", ("no settings.json on this machine names permissions.defaultMode, "
                           "so nothing says what a session should be running in")
    if not mode:
        return "unknown", "nothing could say what mode this session is in"
    if mode_rank(mode) < 0:
        return "unknown", ("`%s` is not a mode this tool knows — a newer CLI, probably; it "
                           "is reported, never judged and never restarted" % mode)
    if mode_rank(mode) >= mode_rank(default_mode):
        return "ok", ""
    if row["entrypoint"] != "sdk-cli":
        return "info", ("`%s` is weaker than %s, but this session was not spawned by a "
                        "Remote Control server (entrypoint %s) — the mode of a session "
                        "started in a terminal is its owner's own choice"
                        % (mode, default_mode, row["entrypoint"] or "none"))
    if mode not in WEAK_BY_ACCIDENT:
        return "info", ("`%s` is weaker than %s, but it is a mode chosen deliberately "
                        "(shift+tab or an explicit flag), never one a Remote Control worker "
                        "records by accident" % (mode, default_mode))
    return "fault", ("a Remote Control worker running `%s` while this machine's defaultMode "
                     "is %s — the stored session mode overrode the server's "
                     "--permission-mode flag, and leaving a stronger mode is one-way: only "
                     "a restart or a move puts it back" % (mode, default_mode))


def modes_report(accts: list, spec: str = None) -> dict:
    """The whole sweep as data: rows, verdicts, counts and coverage. `--json` prints this."""
    use = [resolve(spec, accts)] if spec else accts
    default_mode, where = machine_default_mode(use)
    rows, cov = live_mode_rows(use)
    counts = {}
    for row in rows:
        row["verdict"], row["why"] = judge_mode(row, default_mode)
        key = row["mode"] or "(none)"
        counts[key] = counts.get(key, 0) + 1
    order = {"fault": 0, "unknown": 1, "info": 2, "ok": 3}
    rows.sort(key=lambda r: (order[r["verdict"]], -(r["mtime"] or 0)))
    for i, row in enumerate(rows, 1):
        row["pos"] = i
    return {
        "machine": machine(),
        "at": time.strftime("%Y-%m-%dT%H:%M:%S"), "at_epoch": round(time.time()),
        "scope": ("live sessions in this machine's account homes only — a session on "
                  "another machine is read with `csm --machine <m> modes`"),
        "default_mode": default_mode, "default_mode_from": where,
        "live": len(rows), "mode_counts": counts,
        "faults": sum(1 for r in rows if r["verdict"] == "fault"),
        "deliberate": sum(1 for r in rows if r["verdict"] == "info"),
        "unknown": sum(1 for r in rows if r["verdict"] == "unknown"),
        "respawn_verified": RESPAWN_VERIFIED,
        # `ps` is carried out of the sweep too (added Sun 25 Oct 2026): it is the one
        # prover that covers the whole machine rather than one home, every `unread` reason
        # below turns on whether it answered, and a reader diagnosing an `INCOMPLETE:`
        # otherwise cannot tell a quiet machine from a blinded one. `live_mode_rows` has
        # always measured it; it just had nowhere to go.
        "coverage": {"read": cov["read"], "unread": cov["unread"], "absent": cov["absent"],
                     "ps": cov["ps"]},
        "rows": rows,
    }


def modes_check_line(rep: dict):
    """The ONE line and the exit code: `ok:` 0 · `FAULT:` 1 · `INCOMPLETE:` 3.

    🛑 THIS LINE IS A CONTRACT, and the strictest one in the tool. Scheduled checks run
    `modes --check`, capture stdout AND stderr together, delete the newlines, truncate to a
    couple of hundred characters and match the PREFIX — so one stray byte anywhere in the
    output turns `ok:` into a fault report about the tool instead of a reading of the
    machine. `do_modes` is what keeps the path quiet; this function is what keeps the
    wording stable.

    0 = everything read and no fault · 1 = a fault · 3 = no fault found but the read was
    incomplete. A fault OUTRANKS incomplete ("something IS wrong" is the more useful
    headline), and both are named in the tail.
    """
    unread, n = rep["coverage"]["unread"], rep["live"]
    # ⚠️ ONE SPELLING OF "there is no default to compare against" (added Sun 25 Oct 2026).
    # A machine with no `permissions.defaultMode` in any settings file reports an empty
    # string, and three of the four lines below used to interpolate it raw — so a fresh
    # install's first `modes --check` read `ok: every live session is at  or stronger`, a
    # malformed sentence in the one line this tool promises to keep stable, and a claim
    # about a baseline that is not there. `render_modes` has always said `(none named)` for
    # the same reading, and the `INCOMPLETE:` line below already carried this fallback;
    # now every line uses it. For a machine that DOES name a default — the only case a
    # scheduled caller sees — not a byte moves.
    mode = rep["default_mode"] or "(no defaultMode on this machine)"
    # ⚠️ A machine with nothing running once answered `0 live session(s) on laptop, ;
    # 5 home(s) read` — the dangling comma of an empty count list. A quiet machine is a
    # normal state and must read like one.
    counts = ", ".join("%s %d" % (m, c) for m, c in sorted(rep["mode_counts"].items()))
    tail = "%d live session(s) on %s" % (n, rep["machine"]) + (", " + counts if counts else "")
    if unread:
        tail += "; %d not measured (%s: %s)" % (len(unread), unread[0]["name"],
                                                unread[0]["reason"])
    if rep["faults"]:
        who = ", ".join(sorted(set("%s %s (%s)" % (r["handle"], r["short"], r["mode"])
                                   for r in rep["rows"] if r["verdict"] == "fault")))
        return ("FAULT: %d live Remote Control session(s) weaker than %s: %s — %s"
                % (rep["faults"], mode, who, tail)), 1
    if rep["unknown"] or unread:
        why = ("%d session(s) could not be judged" % rep["unknown"] if rep["unknown"]
               else "%d live session(s) could not be read" % len(unread))
        return ("INCOMPLETE: no session is known to be weaker than %s, but %s — %s"
                % (mode, why, tail)), 3
    if rep["deliberate"]:
        # 🛑 `ok` MAY NOT SAY "every live session is at bypassPermissions or stronger" while
        # a session is sitting in `plan`. Those rows are deliberate — `plan`, `acceptEdits`,
        # or a session started in a terminal — so they are not faults and the exit code
        # stays 0; but the line has to name them, or the one place a scheduled reader looks
        # says the opposite of the table three lines above it.
        who = sorted(set("%s %s (%s)" % (r["handle"], r["short"], r["mode"])
                         for r in rep["rows"] if r["verdict"] == "info"))
        shown = ", ".join(who[:4]) + (", +%d more" % (len(who) - 4) if len(who) > 4 else "")
        return ("ok: no Remote Control worker is weaker than %s by accident; %d "
                "deliberately weaker session(s): %s — %s; %d home(s) read"
                % (mode, rep["deliberate"], shown, tail,
                   len(rep["coverage"]["read"]))), 0
    return ("ok: every live session is at %s or stronger — %s; %d home(s) read"
            % (mode, tail, len(rep["coverage"]["read"]))), 0


def render_modes(rep: dict) -> str:
    """The table a person reads: the sessions that are NOT at the machine's mode, and why."""
    counts = ", ".join("%s %d" % (m, c) for m, c in sorted(rep["mode_counts"].items()))
    out = ["csm modes — %s, %s" % (rep["machine"], rep["at"].replace("T", " ")),
           "machine defaultMode: %s" % (rep["default_mode"] or "(none named)")
           + ("   (%s)" % rep["default_mode_from"] if rep["default_mode_from"] else ""),
           "live sessions: %d" % rep["live"] + ("  (%s)" % counts if counts else "")]
    show = [r for r in rep["rows"] if r["verdict"] in ("fault", "unknown", "info")]
    if show:
        out.append("")
        w = min(max([18] + [len(r["title"]) for r in show]), ROW_TITLE)
        # The account column is as wide as the widest label it holds, floor 6 (`handle` and
        # `(none)` both fit) and ceiling 16, with the HEADER padded to the same width — a
        # header one column off from the rows under it is the first thing a reader notices.
        aw = min(max([6] + [len(r["handle"]) for r in show]), 16)
        out.append("%2s  %-*s %-18s %-6s %4s  %-9s %-*s verdict"
                   % ("#", aw, "acct", "mode", "state", "age", "session", w, "title"))
        for r in show:
            flag = {"fault": "FAULT", "unknown": "unknown", "info": "info"}[r["verdict"]]
            out.append("%2d  %-*s %-18s %-6s %4s  %-9s %-*s %s"
                       % (r["pos"], aw, dcut(r["handle"], aw), r["mode"] or "(none)",
                          r["status"] or "?", r["age"], r["short"],
                          w, tidy(r["title"], w), flag)
                       + ("  ← this session" if r["is_self"] else ""))
        # One sentence per REASON, not per row: ten sessions stuck the same way used to
        # print the same sixty words ten times, which is how a real second reason is missed.
        by_why = {}
        for r in show:
            by_why.setdefault(r["why"], []).append(r)
        for why in by_why:
            rs = by_why[why]
            who = ", ".join("%d %s %s" % (r["pos"], r["handle"], r["short"]) for r in rs)
            srcs = sorted(set(r["mode_source"] for r in rs if r["mode_source"]))
            out.append("")
            out.append("   %s ×%d (%s)" % (rs[0]["verdict"].upper(), len(rs), who))
            out.append("     %s" % why
                       + (" — mode read from %s" % " / ".join(srcs) if srcs else ""))
    else:
        out.append("\nevery live session is at the machine's mode or stronger.")
    for u in rep["coverage"]["unread"]:
        age = ", %ds old" % round(u["age_s"]) if u.get("age_s") is not None else ""
        out.append("   unmeasured: %s%s — %s" % (u["name"], age, u["reason"]))
    if rep["coverage"]["absent"]:
        out.append("   no home on this machine (so nothing of theirs runs here): "
                   + ", ".join(rep["coverage"]["absent"]))
    line, _ = modes_check_line(rep)
    out += ["", line, "", rep["scope"],
            "the plan to fix the faults:  csm modes --restart-idle"]
    return "\n".join(out)


def row_session(row: dict) -> Session:
    """A `Session` standing for one sweep row, for the two things that need one.

    🛑 Built from the ROW, never resolved through the accounts file again. `apply_restart`
    runs in the second between a plan and a SIGTERM; re-reading a table that may have been
    edited since would make the pid proof answer about a different account. Only `pid`,
    `proc_start`, `tmux` and the two names a capture file is named after are ever read.
    """
    acct = Account(name=str(row.get("account") or row.get("handle") or "?"),
                   home=Path(row.get("home") or HOME),
                   handle=str(row.get("handle") or ""))
    return Session(account=acct, local_id=str(row.get("local_id") or ""),
                   transcript=Path(row.get("transcript") or "."),
                   mtime=row.get("mtime") or 0.0, pid=int(row.get("pid") or 0),
                   proc_start=str(row.get("proc_start") or ""),
                   tmux=str(row.get("tmux") or ""))


def last_gate(r: dict) -> str:
    """Why this planned row must NOT be signalled after all, or `""` when it still may be.

    🛑 The five refusals `restart_candidates` applies, re-read in the second between the
    plan and the kill. They are cheap, they are read off the row rather than measured again,
    and a plan built from a report is not a licence: this tool has twice signalled something
    it had only half proved (both incidents are in `still_the_same_process`), so the gate is
    written twice on purpose.
    """
    if r.get("verdict") != "fault":
        return "its verdict is %s, not fault" % (r.get("verdict") or "none")
    if r.get("is_self"):
        return "it is THIS session: stopping it would kill the turn doing the stopping"
    if r.get("is_server"):
        return "its pid is a `claude remote-control` SERVER, never signalled by this tool"
    if r.get("hosts_itself"):
        return "it hosts its own Remote Control session, so nothing would bring it back"
    if r.get("entrypoint") != "sdk-cli":
        return "entrypoint %s, not sdk-cli" % (r.get("entrypoint") or "none")
    if r.get("status") != "idle":
        return "status %s, not idle" % (r.get("status") or "unknown")
    return ""


def restart_candidates(rep: dict):
    """`(the rows --restart-idle --apply would SIGTERM, the rows it refuses and why)`.

    🛑 Six refusals, each one a thing this tool has already been bitten by: never anything
    but a fault, never a server (`claude remote-control` owns every session in its folder),
    never a session that hosts itself (`--remote-control=…`: stopping one leaves it ARCHIVED
    on claude.ai), never THIS session, never a BUSY one, and never a pid whose identity is
    not proved by `procStart` — the same proof `--stop-source` and `csm stop` use, with no
    name-based fallback. A transcript is never touched either way.
    """
    take, skip = [], []
    for r in rep["rows"]:
        if r["verdict"] != "fault":
            continue
        if r["is_self"]:
            skip.append((r, "it is THIS session: stopping it would kill the turn that is "
                            "telling you about it"))
        elif r["is_server"]:
            skip.append((r, "its pid is a `claude remote-control` SERVER, not a worker — "
                            "stopping one takes every session in that folder with it"))
        elif r["hosts_itself"]:
            skip.append((r, "it hosts its own Remote Control session (`--remote-control=…`), "
                            "so there is no server to bring it back: measured, such a "
                            "session reads ARCHIVED on claude.ai afterwards"))
        elif r["entrypoint"] != "sdk-cli":
            skip.append((r, "entrypoint %s, not sdk-cli: only a server-spawned worker is "
                            "respawned on the next message" % (r["entrypoint"] or "none")))
        elif r["status"] != "idle":
            skip.append((r, "its registry says status %s, not idle — a session mid-turn "
                            "loses that turn" % (r["status"] or "unknown")))
        else:
            ok, why = still_the_same_process(row_session(r))
            if ok:
                take.append(r)
            else:
                skip.append((r, why))
    return take, skip


def capture_before_stop(row: dict) -> str:
    """Park this worker's pane scrollback before it is signalled, or `""` — never raises.

    The rule `stop_source` follows: capture, then prove, then signal. Everything else a
    session owns is on disk and survives a SIGTERM; the pane does not. A capture that fails
    may not fail the stop, so every error is swallowed here.
    """
    try:
        return capture_pane(row_session(row), str(row.get("tmux") or ""),
                            "modes --restart-idle")
    except Exception as e:                  # noqa: BLE001 — a capture never fails a stop
        log("could not capture the pane of pid %s before the stop: %s" % (row.get("pid"), e))
        return ""


def apply_restart(take: list):
    """SIGTERM the planned workers. `(the ones signalled, the ones left alone and why)`.

    🛑 ONLY EVER REACHED WHILE `RESPAWN_VERIFIED` IS TRUE — `do_modes` is the gate and the
    constant is the switch, so flipping it after the experiment in its note is all this
    needs. Per row: the five refusals again (`last_gate`), then the proof that the pid is
    still the process its registry row was written for (`still_the_same_process`, the same
    check `csm stop` uses, which REFUSES rather than falling back to a name), then the pane
    capture, then one SIGTERM. Never a SIGKILL, never a server, never this session, never a
    pattern — and no transcript is touched, which is what lets the respawned worker carry
    the same conversation on.
    """
    done, failed = [], []
    for r in take:
        gate = last_gate(r)
        if gate:
            failed.append((r, "left alone at the last gate: %s" % gate))
            log("modes --restart-idle --apply: refused pid %s — %s" % (r["pid"], gate))
            continue
        ok, why = still_the_same_process(row_session(r))
        if not ok:
            failed.append((r, why))
            log("modes --restart-idle --apply: %s" % why)
            continue
        r["pane_kept"] = capture_before_stop(r)
        try:
            os.kill(r["pid"], signal.SIGTERM)
        except OSError as e:
            failed.append((r, "SIGTERM to pid %s failed: %s" % (r["pid"], e)))
            log("modes --restart-idle --apply: SIGTERM to pid %s failed: %s" % (r["pid"], e))
            continue
        done.append(r)
        log("modes --restart-idle --apply: SIGTERM pid %s (%s %s, was %s)"
            % (r["pid"], r["handle"], r["short"], r["mode"] or "(none)"))
    return done, failed


def render_restart(rep: dict, take: list, skip: list, done: list = None, failed: list = None,
                   applied: bool = False) -> str:
    done, failed = done or [], failed or []
    out = ["csm modes --restart-idle%s — %s, %s"
           % (" --apply" if applied else "", rep["machine"], rep["at"].replace("T", " "))]
    if applied:
        out.append("%d idle Remote Control worker(s) SIGTERMed, %d left alone, %d fault "
                   "row(s) refused before the plan:" % (len(done), len(failed), len(skip)))
        for r in done:
            out.append("  STOPPED  pid %-7s %-6s %s %-18s idle %4s  “%s”"
                       % (r["pid"], r["handle"], r["short"], r["mode"] or "(none)",
                          r["age"], tidy(r["title"], 44))
                       + ("   pane kept at %s" % r["pane_kept"] if r.get("pane_kept")
                          else ""))
        for r, why in failed:
            out.append("  left     pid %-7s %-6s %s — %s"
                       % (r["pid"], r["handle"], r["short"], why))
    else:
        out.append("%d idle Remote Control worker(s) would be SIGTERMed, %d fault row(s) "
                   "refused:" % (len(take), len(skip)))
        for r in take:
            out.append("  SIGTERM  pid %-7s %-6s %s %-18s idle %4s  “%s”"
                       % (r["pid"], r["handle"], r["short"], r["mode"] or "(none)",
                          r["age"], tidy(r["title"], 44)))
    for r, why in skip:
        out.append("  leave    pid %-7s %-6s %s — %s"
                   % (r["pid"], r["handle"], r["short"], why))
    out.append("")
    if applied:
        out.append("Each one comes back on the next message to that session from claude.ai, "
                   "in the mode its server was started with; the transcript was not touched, "
                   "so the conversation carries on where it stopped.")
    elif RESPAWN_VERIFIED:
        out.append("add --apply to do it. A worker that is stopped comes back on the next "
                   "message to that session, in the mode its server was started with.")
    else:
        out.append("🛑 --apply is REFUSED: %s." % RESPAWN_WHY)
        out.append("   What is measured, and the one experiment that would settle it, is in "
                   "`RESPAWN_VERIFIED` in this file.")
    if not applied or failed or skip:
        out.append("")
        out.append("What to do instead, per session, each of which IS measured:"
                   if not applied else "For the ones left alone, each of which IS measured:")
        # 🛑 BY SHORT ID, never by `<#>`: these row numbers are this sweep's, while
        # `csm move 3` resolves against the numbering `csm list` last wrote. An id works in
        # both.
        eg = (take or [r for r, _ in skip] or [r for r, _ in failed]
              or [{"short": "<id above>", "handle": "<account>"}])[0]
        out.append("  csm move %s --to <account> --permission-mode bypassPermissions   (by "
                   "the session id in the table, not a row number — keeps the "
                   "conversation, on another account's quota)" % eg["short"])
        out.append("  end the session in claude.ai (or /exit in its tmux window) and reopen "
                   "it — it starts in the server's mode")
    out.append("")
    out.append("(%d signalled, %d left alone)" % (len(done), len(failed)) if applied
               else "(dry run — nothing was signalled)")
    return "\n".join(out)


def do_modes(args, accts: list) -> int:
    """`csm modes` — which live sessions run weaker than this machine says they should.

    🛑 ON THE `--check` PATH: exactly one line on stdout and NOTHING on stderr. A scheduled
    caller concatenates the two streams and matches a prefix, so a warning printed beside
    the verdict IS a false fault. Everything diagnostic goes to the log instead, and the
    credential probe is never on this path at all.
    """
    # 🛑 `--apply` ON ITS OWN IS A REFUSAL, not a flag quietly dropped. It is the only
    # destructive switch in this subcommand, and `csm modes --apply` used to print the
    # read-only table and exit 0 — a reading of the machine that looks exactly like a
    # report of work done. Refusing costs nothing: `--apply` means something only next to
    # `--restart-idle`, which prints the plan first.
    if args.apply and not args.restart_idle:
        die("--apply does nothing on its own, and signalled nothing: it is the switch on "
            "`csm modes --restart-idle`, which prints the plan first")
    rep = modes_report(accts, args.account)
    if args.restart_idle:
        take, skip = restart_candidates(rep)
        # 🛑 THE ONE GATE. `--apply` signals only while `RESPAWN_VERIFIED` is True. The dry
        # run is printed either way, because the question asked was what would happen.
        applied = bool(args.apply) and RESPAWN_VERIFIED
        done, failed = apply_restart(take) if applied else ([], [])
        if args.as_json:
            rep["restart"] = {"would_stop": [r["pos"] for r in take],
                              "refused": [{"pos": r["pos"], "why": w} for r, w in skip],
                              "applied": applied,
                              "stopped": [r["pos"] for r in done],
                              "failed": [{"pos": r["pos"], "why": w} for r, w in failed],
                              "respawn_verified": RESPAWN_VERIFIED}
            print(json.dumps(rep, indent=1))
        else:
            print(render_restart(rep, take, skip, done, failed, applied=applied))
        log("modes --restart-idle: %d would stop, %d refused, applied=%s, stopped=%d, "
            "left alone %d, respawn_verified=%s"
            % (len(take), len(skip), applied, len(done), len(failed), RESPAWN_VERIFIED))
        if args.apply and not RESPAWN_VERIFIED:
            # The refusal is the exit code and one line on stderr, so a caller cannot read
            # the plan above as something that happened.
            die("--apply is refused: %s. Nothing was signalled." % RESPAWN_WHY)
        return 1 if failed else 0
    line, code = modes_check_line(rep)
    if args.check:
        if args.as_json:
            rep["check"] = {"line": line, "exit": code}
            print(json.dumps(rep, indent=1))
        else:
            print(line)
        log("modes --check: rc=%d — %s" % (code, line))
        return code
    if args.as_json:
        print(json.dumps(rep, indent=1))
    else:
        print(render_modes(rep))
    log("modes: %d live, %d fault(s), %d unknown, %d unmeasured"
        % (rep["live"], rep["faults"], rep["unknown"], len(rep["coverage"]["unread"])))
    return 0


# ------------------------------------------------------------------- another machine

#: 🛑 WHAT RUNS ON THE OTHER MACHINE. It is piped to that machine's own python over ssh, so
#: it needs NOTHING there: not this file, not an accounts file, not a package. Hence the
#: standard library only, no annotations and no syntax newer than 3.6 — the interpreter on
#: the far side is whatever `CSM_REMOTE_PYTHON` names, by default the system python, and a
#: machine you have not touched in a year still has to answer. Three modes, each printing
#: ONE JSON line:
#:   find <text> <days>          sessions in every `~/.claude*` home there — the default one
#:                               included, which is where the desktop app keeps its sessions
#:                               — matched by id (the CLI's uuid or the desktop app's
#:                               `local_` id, 4+ characters), a claude.ai link (DERIVED to
#:                               the transcript's name, so a dead session resolves; and
#:                               through the live registry's own `bridgeSessionId`), or
#:                               title text (the desktop app's own title first)
#:   detail <path> <id> [cse]    the sibling directory's size, the desktop-app tools the
#:                               session used, the process that owns it (`--resume[= ]<id>`,
#:                               never a bare id: a side session's argv names it in a path)
#:                               and what that process started that is still running. The
#:                               optional third word is the BARE bridge id, because a
#:                               Remote-Control server child's argv carries only that
#:                               (`--session-id cse_X`) and never the local uuid
#:   mirror <cwd> <file max>     the files `--mirror-cwd` would copy, and what it would leave
#: ⚠️ It reads `CSM_DESKTOP_INDEX` from ITS OWN environment, because the path is that
#: machine's, not this one's: an override set here would be the wrong spelling there.
REMOTE_HELPER = r'''
import json, os, re, subprocess, sys, time, uuid

H = os.path.expanduser("~")
HEAD, TAIL = 96 * 1024, 512 * 1024
QUOTA = ("usage_limit_reached", "rate_limit_error", "rate_limit_exceeded")
DESK = os.environ.get("CSM_DESKTOP_INDEX") or os.path.join(
    H, "Library", "Application Support", "Claude", "claude-code-sessions")
NOISE = re.compile(r"(disclaimer|/claude(\.app)?/|MacOS/claude|\bnode\b|\bnpx\b|\buvx\b|\bbun\b|"
                   r"mcp|caffeinate|^\S*/?(ba|z)?sh -c |^\S*/?(ba|z)?sh$)")
# The engine's BRIDGE_NS / SPEC_SEG_RE / SHEEP_SESSION_RE, kept identical word for word: a
# link has to resolve to the same transcript here as it does there, or a row found on one
# machine is not the row found on the other.
NS = uuid.UUID("3ab19d7e-9f35-45c2-926e-75e271cc60b3")
SEG = re.compile(r"^(?:session|cse)_[A-Za-z0-9_]+$")
SHEEP = re.compile(r"spacesheep\.dev/sessions/claude-code/"
                   r"([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}"
                   r"-[0-9a-fA-F]{12})")


def bare_id(spec):
    """The bare claude.ai/bridge id in `spec`, by the CLI's own rule, or "" — the engine's
    `bare_bridge_id`: split on `/?#`, first segment that is ENTIRELY such an id."""
    for part in re.split(r"[/?#]", (spec or "").strip()):
        if SEG.match(part):
            return part.split("_", 1)[1]
    return ""


def derive(spec):
    """The local transcript id `spec` names, computed — the engine's `derive_local_id`.

    🛑 This is what makes a link find a DEAD session: the local id is uuid5 of the bridge
    session's own api url, so the transcript's name is arithmetic. Without it, `find` could
    only match a link against a live registry row (which the helper never read) or a
    transcript's own `bridge-session` line (which a server child never writes), so every
    link to a stopped phone session answered "no session matches".
    """
    m = SHEEP.search(spec or "")
    if m:
        return m.group(1).lower()
    b = bare_id(spec)
    if not b:
        return ""
    return str(uuid.uuid5(NS, "https://api.anthropic.com/v1/code/sessions/cse_" + b))


def live_bridges(home):
    """`{local session id: bare bridge id}` from `<home>/sessions/*.json`.

    The registry is the only place a LIVE Remote-Control child's two ids sit together: its
    transcript carries no bridge id at all. `os.listdir`, never glob, for the same reason
    the engine gives: a directory this process may not read has to raise, not read as empty.
    """
    out = {}
    d = os.path.join(home, "sessions")
    try:
        names = os.listdir(d)
    except OSError:
        return out
    for n in names:
        if not n.endswith(".json") or n.startswith("."):
            continue
        try:
            f = open(os.path.join(d, n))
        except Exception:
            continue
        try:
            r = json.load(f)
        except Exception:
            r = None
        finally:
            f.close()
        if not isinstance(r, dict):
            continue
        sid = r.get("sessionId")
        b = re.sub(r"^(cse_|session_)", "", str(r.get("bridgeSessionId") or ""))
        if isinstance(sid, str) and sid and b:
            out[sid] = b
    return out


def jlines(blob, drop_first=False):
    parts = blob.split(b"\n")
    if drop_first and parts:
        parts = parts[1:]
    for ln in parts:
        ln = ln.strip()
        if not ln.startswith(b"{"):
            continue
        try:
            d = json.loads(ln.decode("utf-8", "replace"))
        except ValueError:
            continue
        if isinstance(d, dict):
            yield d


def run(argv, timeout):
    """`subprocess.run` with pipes spelled out: `capture_output` is 3.7, and this file is
    handed to whatever python the other machine has."""
    try:
        return subprocess.Popen(argv, stdout=subprocess.PIPE,
                                stderr=subprocess.PIPE).communicate(timeout=timeout)[0]
    except Exception:
        return b""


def homes():
    out = []
    try:
        names = sorted(os.listdir(H))
    except OSError:
        return out
    for n in names:
        if n == ".claude" or n.startswith(".claude-"):
            p = os.path.join(H, n)
            if os.path.isdir(os.path.join(p, "projects")):
                out.append(p)
    return out


def login(home):
    """The login a home holds. 🛑 The default home's state file is OUTSIDE it (~/.claude.json)."""
    cj = (os.path.join(H, ".claude.json") if home == os.path.join(H, ".claude")
          else os.path.join(home, ".claude.json"))
    try:
        f = open(cj)
    except Exception:
        return "", ""
    try:
        oa = json.load(f).get("oauthAccount") or {}
    except Exception:
        oa = {}
    finally:
        f.close()
    if not isinstance(oa, dict):
        oa = {}
    return oa.get("emailAddress") or "", oa.get("organizationUuid") or ""


def desktop():
    """The desktop app's own session index, keyed by the CLI session id it wraps.

    The app keeps its sessions in the DEFAULT config home and its titles nowhere in the
    transcript, so without this a desktop session is a row with no name.
    """
    out = {}
    for root, _dirs, files in os.walk(DESK):
        for f in files:
            if not (f.startswith("local_") and f.endswith(".json")):
                continue
            try:
                h = open(os.path.join(root, f))
            except Exception:
                continue
            try:
                d = json.load(h)
            except Exception:
                continue
            finally:
                h.close()
            if not isinstance(d, dict):
                continue
            cid = d.get("cliSessionId")
            if isinstance(cid, str) and cid:
                out[cid] = dict((k, d.get(k)) for k in (
                    "sessionId", "title", "cwd", "isArchived", "permissionMode", "model",
                    "effort", "error", "lastActivityAt", "bridgeSessionIds"))
    return out


def scan(p):
    info = {"cwd": "", "custom": "", "ai": "", "last": "", "first": "", "bridge": "",
            "quota": "", "perm": "", "model": "", "sidechain_only": True}
    try:
        size = os.path.getsize(p)
        f = open(p, "rb")
    except OSError:
        return info
    try:
        head = f.read(min(size, HEAD))
        if size > HEAD + TAIL:
            f.seek(size - TAIL)
            tail, drop = f.read(), True
        else:
            f.seek(0)
            tail, drop = f.read(), False
    except OSError:
        return info
    finally:
        f.close()
    for d in jlines(head):
        if not d.get("isSidechain", False):
            info["sidechain_only"] = False
        if not info["cwd"] and isinstance(d.get("cwd"), str):
            info["cwd"] = d["cwd"]
        if d.get("type") == "custom-title" and isinstance(d.get("customTitle"), str):
            info["custom"] = d["customTitle"]
        if not info["perm"] and isinstance(d.get("permissionMode"), str):
            info["perm"] = d["permissionMode"]
        # The FIRST prompt, the last resort for a title, by the same rule the local scan
        # uses: `type == "text"` parts only, and a relayed `<...>` prompt is no title.
        # Without it a remote listing left the title column blank for every transcript
        # with no title line of its own. Bounded at 400 characters: this travels raw in
        # the one JSON line the helper returns.
        if not info["first"] and d.get("type") == "user" and not d.get("isSidechain"):
            mm = d.get("message") or {}
            c = mm.get("content") if isinstance(mm, dict) else None
            if isinstance(c, str):
                t = c
            elif isinstance(c, list):
                t = "\n".join(str(x.get("text") or "") for x in c
                              if isinstance(x, dict) and x.get("type") == "text")
            else:
                t = ""
            t = t.strip()
            if t and not t.lstrip().startswith("<"):
                info["first"] = t[:400]
    for d in jlines(tail, drop):
        t = d.get("type")
        if not d.get("isSidechain", False):
            info["sidechain_only"] = False
        if t == "custom-title" and isinstance(d.get("customTitle"), str):
            info["custom"] = d["customTitle"]
        elif t == "ai-title" and isinstance(d.get("aiTitle"), str):
            info["ai"] = d["aiTitle"]
        elif t == "last-prompt" and isinstance(d.get("lastPrompt"), str):
            info["last"] = d["lastPrompt"]
        elif t == "bridge-session" and isinstance(d.get("bridgeSessionId"), str):
            info["bridge"] = re.sub(r"^(cse_|session_)", "", d["bridgeSessionId"])
        elif t == "system" and d.get("subtype") == "bridge_status" and not info["bridge"]:
            # The engine's `_status_bridge`: a `/remote-control is active` line carries the
            # claude.ai url, and it sits in the TAIL while a `bridge-session` line sits once
            # near the start and can fall into the unread middle of a long transcript.
            u = d.get("url")
            if isinstance(u, str):
                info["bridge"] = bare_id(u)
        if not info["cwd"] and isinstance(d.get("cwd"), str):
            info["cwd"] = d["cwd"]
        if (t in ("permission-mode", "user") and not d.get("isSidechain")
                and isinstance(d.get("permissionMode"), str)):
            info["perm"] = d["permissionMode"]
        m = d.get("message")
        if t == "assistant" and isinstance(m, dict):
            err = d.get("apiError") or m.get("apiError")
            # ONE READING RULE, HERE TOO. `cmd_find` promises that a row found on this
            # machine and a row found on another are the same row, and it runs this helper
            # for both — so the engine's two quota shapes have to be this helper's two as
            # well. 10 of the 44 real stop lines measured here carry no `apiError` at all,
            # only `isApiErrorMessage` + `error: "rate_limit"`, and reading those as clean
            # both missed the limit AND cleared one found earlier in the file.
            mdl = m.get("model")
            real_model = not isinstance(mdl, str) or bool(
                re.match(r"^[A-Za-z0-9][A-Za-z0-9._\[\]-]{1,63}$", mdl))
            if err in QUOTA or (d.get("isApiErrorMessage")
                                and d.get("error") == "rate_limit"):
                c = m.get("content")
                txt = ""
                if isinstance(c, list):
                    txt = " ".join(str(x.get("text") or "") for x in c if isinstance(x, dict))
                info["quota"] = (txt or err or d.get("error") or "rate_limit")[:120]
            elif not err and not d.get("isApiErrorMessage") and real_model:
                # Only a line that is really the session ANSWERING clears a quota found
                # earlier: an error that is not a limit is not an answer, and neither is a
                # `<synthetic>` "No response requested." line.
                info["quota"] = ""
                if isinstance(mdl, str) and real_model:
                    info["model"] = mdl
    return info


def find(spec, days):
    raw = spec.strip()
    low = raw.lower()
    m = re.search(r"(?:session_|cse_)([A-Za-z0-9]{10,})", raw)
    bridge = m.group(1) if m else ""
    derived = derive(raw)
    idq = low[6:] if low.startswith("local_") else low
    idlike = bool(re.match(r"^[0-9a-f][0-9a-f-]{3,35}$", idq))
    desk = desktop()
    cutoff = time.time() - days * 86400
    out = []
    for home in homes():
        email, org = login(home)
        lb = live_bridges(home)
        pj = os.path.join(home, "projects")
        try:
            folders = sorted(os.listdir(pj))
        except OSError:
            continue
        for folder in folders:
            fd = os.path.join(pj, folder)
            try:
                names = os.listdir(fd)
            except OSError:
                continue
            for n in names:
                if not n.endswith(".jsonl"):
                    continue
                sid = n[:-6]
                p = os.path.join(fd, n)
                try:
                    st = os.stat(p)
                except OSError:
                    continue
                dk = desk.get(sid) or {}
                local = str(dk.get("sessionId") or "").lower()
                hit = ""
                if idlike and (sid.lower().startswith(idq) or local.startswith("local_" + idq)):
                    hit = "id"
                # 🛑 THE DERIVED NAME AND THE LIVE REGISTRY, BOTH ABOVE THE AGE CUTOFF. The
                # cutoff's `continue` below runs before the transcript is even read, so a
                # link rung placed after it could not reach a session older than the window
                # — and the session somebody has lost the link to is exactly the old one.
                elif derived and sid.lower() == derived:
                    hit = "url"
                elif bridge and any(bridge in str(b) for b in (dk.get("bridgeSessionIds") or [])):
                    hit = "url"
                elif bridge and bridge == lb.get(sid, ""):
                    hit = "url"
                elif st.st_mtime < cutoff:
                    continue
                info = scan(p)
                if info["sidechain_only"]:
                    continue
                if not hit and bridge and info["bridge"] and bridge in info["bridge"]:
                    hit = "url"
                title, src = "", ""
                for k, v in (("desktop", dk.get("title")), ("custom", info["custom"]),
                             ("ai", info["ai"]), ("last-prompt", info["last"]),
                             ("first-prompt", info["first"])):
                    if isinstance(v, str) and v.strip():
                        title, src = v, k
                        break
                if not hit and not bridge and (not low or low in title.lower()):
                    hit = "title"
                if not hit:
                    continue
                bids = [re.sub(r"^(cse_|session_)", "", str(b))
                        for b in (dk.get("bridgeSessionIds") or [])]
                out.append({"id": sid, "path": p, "home": home, "email": email, "org": org,
                            "folder": folder, "mtime": st.st_mtime, "size": st.st_size,
                            "cwd": info["cwd"] or str(dk.get("cwd") or ""), "title": title,
                            "title_from": src, "hit": hit, "desktop": dk or None,
                            "quota": str(dk.get("error") or "") or info["quota"],
                            # The transcript's own claim first, then the LIVE registry row
                            # (the only place a running server child's two ids meet), then
                            # the desktop app's index.
                            "bridge": (info["bridge"] or lb.get(sid, "")
                                       or (bids[-1] if bids else "")),
                            "perm": str(dk.get("permissionMode") or "") or info["perm"],
                            "model": info["model"] or str(dk.get("model") or "")})
    out.sort(key=lambda c: -c["mtime"])
    return {"candidates": out, "homes": homes()}


def ps_rows():
    txt = run(["ps", "-axww", "-o", "pid=,ppid=,etime=,command="], 20).decode(
        "utf-8", "replace")
    rows = {}
    for ln in txt.splitlines():
        p = ln.split(None, 3)
        if len(p) == 4 and p[0].isdigit() and p[1].isdigit():
            rows[int(p[0])] = (int(p[1]), p[2], p[3])
    return rows


def short_cmd(cmd):
    toks = cmd.split()
    if not toks:
        return cmd
    return " ".join([os.path.basename(toks[0])] + toks[1:])[:160]


def detail(path, sid, bridge=""):
    out = {"sibling_bytes": 0, "sibling_files": 0, "app_tools": 0, "owners": [], "left": []}
    side = path[:-6] if path.endswith(".jsonl") else path
    for root, _d, files in os.walk(side):
        for f in files:
            try:
                out["sibling_bytes"] += os.lstat(os.path.join(root, f)).st_size
                out["sibling_files"] += 1
            except OSError:
                pass
    try:
        f = open(path, "rb")
    except OSError:
        f = None
    if f is not None:
        try:
            for ln in f:
                if b'"name":"mcp__ccd_' in ln:
                    out["app_tools"] += 1
        except OSError:
            pass
        finally:
            f.close()
    rows = ps_rows()
    me = (os.getpid(), os.getppid())
    # 🛑 A SERVER CHILD NAMES ONLY ITS BRIDGE ID, and this used to fail in the dangerous
    # direction. A Remote-Control worker's argv is `--print --sdk-url …/cse_X --session-id
    # cse_X --resume=<that url>` and carries the local uuid NOWHERE (measured on CLI 2.1.312,
    # Wed 28 Oct 2026), so matching on `sid` alone came back with no owner — read upstream
    # as "nothing is running on that machine", which is what `--stop-source`'s cross-machine
    # refusal and the move note's "still running on <origin>" clause both key on. The bare
    # bridge id is the third argv word for exactly this; `\S*` covers both spellings, the
    # bare `cse_X` and the sdk url that ends in it.
    pats = [r"--(?:resume|session-id)[= ]" + re.escape(sid) + r"\b"]
    if bridge:
        pats.append(r"--(?:resume|session-id|sdk-url)[= ]\S*cse_" + re.escape(bridge)
                    + r"\b")
    own = re.compile("|".join(pats))
    owners = [p for p, r in rows.items() if p not in me and own.search(r[2])]
    kids = {}
    for p, r in rows.items():
        kids.setdefault(r[0], []).append(p)
    seen, todo = set(owners), list(owners)
    while todo:
        p = todo.pop()
        for k in kids.get(p, []):
            if k not in seen:
                seen.add(k)
                todo.append(k)
    # The desktop app wraps the CLI in a process whose argv repeats `--resume=<id>`: name
    # the innermost owner, the CLI itself, not the wrapper as a second one.
    inner = [p for p in owners if not any(rows[q][0] == p for q in owners)]
    for p in inner or owners:
        out["owners"].append({"pid": p, "etime": rows[p][1], "cmd": short_cmd(rows[p][2])[:100]})
    for p in sorted(seen - set(owners)):
        cmd = rows[p][2]
        if NOISE.search(cmd):
            continue
        out["left"].append({"pid": p, "etime": rows[p][1], "cmd": short_cmd(cmd)})
    out["left"] = out["left"][:12]
    return out


def git(top, *a):
    try:
        p = subprocess.Popen(["git", "-C", top] + list(a), stdout=subprocess.PIPE,
                             stderr=subprocess.PIPE)
        o = p.communicate(timeout=120)[0]
    except Exception:
        return None
    return o if p.returncode == 0 else None


def mirror(cwd, file_max):
    t = git(cwd, "rev-parse", "--show-toplevel")
    if not t:
        return {"git": False}
    top = t.decode("utf-8", "replace").strip()
    if not os.path.isdir(os.path.join(top, ".git")):
        return {"git": True, "top": top, "linked_worktree": True}
    rels = set()
    for r in (git(top, "ls-files", "-z", "-co", "--exclude-standard") or b"").split(b"\0"):
        if r:
            rels.add(r.decode("utf-8", "surrogateescape"))
    for root, _dirs, files in os.walk(os.path.join(top, ".git")):
        for f in files:
            rels.add(os.path.relpath(os.path.join(root, f), top))
    keep, skip, total = [], [], 0
    for r in sorted(rels):
        try:
            st = os.lstat(os.path.join(top, r))
        except OSError:
            continue
        if not r.startswith(".git/") and st.st_size > file_max:
            skip.append([r, st.st_size])
            continue
        keep.append(r)
        total += st.st_size
    try:
        kb = int(run(["du", "-sk", top], 300).decode("utf-8", "replace").split()[0])
    except Exception:
        kb = 0
    head = (git(top, "rev-parse", "--short", "HEAD") or b"").decode("utf-8", "replace").strip()
    branch = (git(top, "rev-parse", "--abbrev-ref", "HEAD") or b"").decode(
        "utf-8", "replace").strip()
    dirty = [x for x in (git(top, "status", "--porcelain") or b"").decode(
        "utf-8", "replace").splitlines() if x]
    return {"git": True, "top": top, "files": keep, "skipped": skip, "bytes": total,
            "all_bytes": kb * 1024, "head": head, "branch": branch, "dirty": len(dirty)}


