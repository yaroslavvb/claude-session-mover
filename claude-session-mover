def over_ssh(dest: str, argv: list) -> int:
    """Run the same command on another machine, where the tool is installed on PATH.

    A plain `ssh host cmd` gets no login profile, so `~/.local/bin` and Homebrew are often
    not on its PATH; they are added before the command.
    """
    rest, i = [], 0
    while i < len(argv):
        if argv[i] == "--ssh":
            i += 2
            continue
        if argv[i].startswith("--ssh="):
            i += 1
            continue
        rest.append(argv[i])
        i += 1
    path = "PATH=$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"
    remote = " ".join(shlex.quote(a) for a in [PROG, *rest])
    log(f"ssh {dest}: {remote}")
    r = subprocess.run(["ssh", dest, f"{path} {remote}"])
    if r.returncode in (126, 127):
        print(f"{PROG}: {dest} could not run {PROG} (exit {r.returncode}): is it installed "
              "there (./install.sh)?", file=sys.stderr)
    return r.returncode


def cmd_accounts(accts: list, as_json: bool) -> int:
    rows = []
    for a in accts:
        live = len(live_rows(a)) if a.home.is_dir() else 0
        cred = None
        if not a.home.is_dir():
            state = "no such directory"
        elif not a.email:
            state = "signed out"
        elif a.expect and a.email.lower() != a.expect.lower():
            state = f"WRONG LOGIN (expected {a.expect})"
        else:
            # 🛑 The same primitive the move gate uses, so the view and the refusal can
            # never disagree about whether a home can actually talk to Claude.
            cred = credential_present(a)
            state = ("ok" if cred is True
                     else "CREDENTIAL GONE" if cred is False else "ok (UNVERIFIED)")
        rows.append({"name": a.name, "home": str(a.home), "default": a.default,
                     "email": a.email, "expected": a.expect, "state": state,
                     "credential": cred, "live_sessions": live,
                     "tmux_session": a.tmux_session})
    if as_json:
        print(json.dumps(rows, indent=1))
        return 0
    if not rows:
        print("no config homes found.\n\n" + ACCOUNTS_HELP)
        return 0
    src = (f"from {tilde(ACCOUNTS_FILE)}" if ACCOUNTS_FILE.is_file()
           else "discovered: ~/.claude and ~/.claude-*")
    print(f"accounts on {host()} ({src})\n")
    nw = max(len(r["name"]) for r in rows)
    ew = max([len(r["email"] or "-") for r in rows] + [5])
    for r in rows:
        home = tilde(r["home"]) + ("  (CLAUDE_CONFIG_DIR unset)" if r["default"] else "")
        print(f"  {r['name']:<{nw}}  {r['email'] or '-':<{ew}}  {r['state']:<16}  "
              f"live {r['live_sessions']:<3} {home}")
    print("\n  state: `ok` = the home names a login AND its credential is there; "
          "`CREDENTIAL GONE` =\n  the home still names someone but the credential is not "
          "there any more (sign it in again);\n  `ok (UNVERIFIED)` = the credential store "
          "could not be asked, which is not the same as\n  signed out. The credential "
          "itself is never read, printed or copied.\n\n  `live N` counts the home's "
          "RUNNING Claude Code processes. `csm list` can show fewer: a\n  session whose "
          "transcript holds only a subagent's own turns is not a session you can move.\n"
          "\n  `csm matrix` says what these "
          "homes SHARE — settings, CLAUDE.md, skills, plugins, memory —\n  and what stays "
          "per account whatever you do.")
    return 0


def main(argv: list) -> int:
    if argv[:1] == ["__run"]:
        if len(argv) < 2:
            print(f"{PROG} __run needs a plan file (it is not for hand use)", file=sys.stderr)
            return 2
        return run_window(argv[1])

    ap = argparse.ArgumentParser(
        prog="csm", description="Move a Claude Code session to another of your own Claude "
        "accounts, keeping the whole conversation. A move is between two config homes on "
        "ONE machine: it copies the transcript into the target home and resumes it there, "
        "so every turn from then on is spent on that account's quota.",
        epilog="What a move costs, and what it cannot carry (connectors, MCP sign-ins, "
               "plugins, preserved thinking across organizations): README.md. Design notes "
               "and the measured on-disk formats: docs/design.md.")
    ap.add_argument("--version", action="version", version=f"{PROG} {__version__}")
    ap.add_argument("--ssh", metavar="HOST",
                    help="run this same command ON that machine, where csm is installed "
                         "too. A move is always between two config homes of ONE machine, "
                         "so this moves sessions over there, never from here to there")
    sub = ap.add_subparsers(dest="cmd")

    pa = sub.add_parser("accounts", help="the config homes here, and who is signed in",
                        description=ACCOUNTS_HELP,
                        formatter_class=argparse.RawDescriptionHelpFormatter)
    pa.add_argument("--json", action="store_true", dest="as_json")

    pl = sub.add_parser("list", help="recent sessions in every account, newest first")
    pl.add_argument("--account", metavar="NAME", help="only this account")
    pl.add_argument("--all", action="store_true", help=f"up to {ALL_LIMIT} sessions")
    pl.add_argument("--json", action="store_true", dest="as_json",
                    help="the same rows as JSON, for a script")
    pl.add_argument("--limit", type=int, default=DEFAULT_LIMIT, metavar="N",
                    help=f"how many sessions to list (default {DEFAULT_LIMIT}). It caps "
                         "the ENDED ones only: every live session is listed whatever the "
                         "limit, so a small number can still print a long table")

    pm = sub.add_parser("move", help="move one session to another account",
                        description="Copy a session into another account's config home and "
                                    "resume it there, on that account's quota. Both homes "
                                    "are on THIS machine.")
    pm.add_argument("session", help="row number from `csm list`, session id or prefix, "
                    "claude.ai link, or part of the title")
    pm.add_argument("--to", required=True, metavar="ACCOUNT", help="the account to move it to")
    pm.add_argument("--stop-source", action="store_true",
                    help="stop the old process once the new one has connected (only in the "
                         "default Remote Control mode, where the link proves it connected). "
                         "The source pane's scrollback is captured to <state dir>/captures/"
                         "<date>/ first, and the path is printed")
    pm.add_argument("--dry-run", action="store_true", help="print the plan, change nothing")
    pm.add_argument("--no-remote-control", action="store_true",
                    help="start a plain interactive session in tmux, without Remote Control")
    pm.add_argument("--foreground", action="store_true",
                    help="resume in this terminal instead of tmux")
    pm.add_argument("--permission-mode", metavar="MODE",
                    help="the permission mode to resume in: " + ", ".join(MODE_ORDER)
                         + " (`manual` is an alias of `default`). Without it the mode the "
                           "session was running in is used, raised to the target home's "
                           "permissions.defaultMode when that is stronger and the session "
                           "recorded nothing, `default` or `auto` — an automatic choice "
                           "never weakens a session. An explicit mode here is obeyed as "
                           "given, including a weaker one")
    pm.add_argument("--name", help="the --remote-control name of the moved session")
    pm.add_argument("--all", action="store_true", help="search every session, not just the newest")

    ps = sub.add_parser("stop", help="end a session csm moved, and free its window",
                        description="End a session THIS TOOL moved and remove the tmux "
                                    "window it opened — the cleanup, and the unblocker for "
                                    "moving the same session to the same account again. It "
                                    "stops nothing else: the authorisation is csm's own "
                                    "window (`moved-<id8>` in `csm-<account>`) plus, for a "
                                    "running session, a registry row naming that window. "
                                    "The transcript is never deleted.")
    ps.add_argument("session", help="row number from `csm list`, session id or prefix, "
                    "claude.ai link, or part of the title")
    ps.add_argument("--dry-run", action="store_true", help="print the plan, change nothing")

    px = sub.add_parser("matrix", help="what your config homes share, and what is per "
                                       "account",
                        description="Your own fungibility matrix: rows are the layers "
                                    "that decide whether your accounts are "
                                    "interchangeable, columns are the config homes on "
                                    "this machine. It is READ-ONLY, offline and "
                                    "prompt-free: it writes nothing into any config home "
                                    "(only a line in csm's own log), never runs `claude` "
                                    "and makes no network call, so it is safe from a hook "
                                    "or a scheduled check. It does ask `git` for the "
                                    "project root, and on macOS asks the keychain whether "
                                    "an item exists — never for its value.",
                        epilog="A cell is a measurement, never a guess: `?` means the "
                               "matrix could not look, which is not the same as `no`, and "
                               "is never counted as a match. The layer-by-layer story, "
                               "and how to make each one fungible: docs/"
                               "fungibility-matrix.md and docs/setup.md.")
    px.add_argument("--json", action="store_true", dest="as_json",
                    help="the whole table as JSON: homes, rows, cells, summary, exit")
    px.add_argument("--cwd", metavar="DIR",
                    help="the project the first-run gates and the memory row are measured "
                         "for (default: the current directory)")
    px.add_argument("--account", metavar="NAME", action="append",
                    help="only these columns; repeatable, or one comma-separated list")
    px.add_argument("--check", action="store_true",
                    help="exit 1 when a shareable layer diverges or a login is gone. An "
                         "unknown never fails it: a cell nobody could read is not a fault")

    args = ap.parse_args(argv)
    if args.ssh:
        return over_ssh(args.ssh, argv)
    if not args.cmd:
        ap.print_help()
        return 0
    try:
        accts = load_accounts()
        if args.cmd == "accounts":
            return cmd_accounts(accts, args.as_json)
        if args.cmd == "list":
            use = [resolve(args.account, accts)] if args.account else accts
            rows = all_sessions(use, ALL_LIMIT if args.all else max(1, args.limit))
            save_picks(rows)
            log(f"list: {len(rows)} rows" + (f" (account {args.account})" if args.account else ""))
            print(json.dumps([r.row() for r in rows], indent=1) if args.as_json
                  else render_list(rows, accts))
            return 0
        if args.cmd == "move":
            return do_move(args, accts)
        if args.cmd == "stop":
            return do_stop(args, accts)
        if args.cmd == "matrix":
            want = []
            for spec in (args.account or []):
                for part in spec.split(","):
                    if part.strip():
                        a = resolve(part.strip(), accts)
                        if a not in want:
                            want.append(a)
            return cmd_matrix(want or accts, args.cwd, args.as_json, args.check)
    except Refusal as e:
        log(f"REFUSED: {e}")
        print(f"csm: {e}", file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except BrokenPipeError:
        os._exit(0)
    except KeyboardInterrupt:
        sys.exit(130)
